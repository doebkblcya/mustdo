page {
  min-height: 100%;
  background: #f9f9f9;
}

.settings-page {
  min-height: 100vh;
  background: #f9f9f9;
  color: #1a1c1c;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.settings-navbar {
  height: 64rpx;
  padding-bottom: 16rpx;
  box-sizing: content-box;
}

.settings-navbar-content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  width: 100%;
  height: 64rpx;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.back-button:active {
  transform: scale(0.92);
  opacity: 0.65;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
}

.settings-wordmark {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.settings-content {
  padding: 48rpx 40rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.settings-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.settings-title,
.quota-title,
.help-title,
.mode-title {
  display: block;
}

.settings-title,
.quota-title,
.help-title {
  color: #000000;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 82rpx;
  letter-spacing: -0.02em;
}

.mode-list {
  margin-top: 32rpx;
}

.mode-panel,
.quota-panel,
.quota-state {
  width: 100%;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

.mode-panel,
.quota-panel {
  overflow: hidden;
}

.mode-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 32rpx 40rpx;
  border-radius: 0;
  background: transparent;
  color: #000000;
  text-align: left;
  box-sizing: border-box;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.mode-item::after {
  display: none;
}

.mode-item:active {
  transform: scale(0.985);
  opacity: 0.7;
}

.mode-title {
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.mode-check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-left: 24rpx;
  opacity: 0;
}

.mode-check--visible {
  opacity: 1;
}

.mode-divider,
.quota-divider {
  height: 1rpx;
  margin: 0 40rpx;
  background: #ededed;
}

.quota-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 80rpx;
}

.help-heading {
  margin-top: 80rpx;
}

.help-list {
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.help-item,
.help-leading {
  display: flex;
  align-items: center;
}

.help-item {
  justify-content: space-between;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 28rpx 32rpx;
  border-radius: 0;
  background: transparent;
  text-align: left;
  box-sizing: border-box;
}

.help-item::after {
  display: none;
}

.help-item:active {
  opacity: 0.7;
}

.help-leading {
  min-width: 0;
  gap: 20rpx;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.72;
}

.help-item-title {
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.help-chevron {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.42;
}

.quota-item-title,
.quota-value,
.quota-error-text {
  display: block;
}

.quota-list {
  margin-top: 32rpx;
}

.quota-item {
  padding: 32rpx 40rpx;
}

.quota-item--disabled {
  opacity: 0.56;
}

.quota-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.quota-item-title {
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.quota-value {
  flex: 0 0 auto;
  color: #5d5e63;
  font-size: 26rpx;
  line-height: 38rpx;
}

.quota-progress {
  width: 100%;
  height: 10rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ededed;
}

.quota-progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: #1a1c1c;
  transition: width 240ms ease-out;
}

.quota-state {
  margin-top: 32rpx;
  padding: 36rpx 40rpx;
  color: #77787c;
  font-size: 28rpx;
  line-height: 40rpx;
}

.quota-state--error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.quota-error-text {
  min-width: 0;
}

.quota-retry {
  flex: 0 0 auto;
  min-width: 116rpx;
  margin: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eeeeee;
  color: #1a1c1c;
  font-size: 26rpx;
  line-height: 36rpx;
}

.quota-retry::after {
  display: none;
}
