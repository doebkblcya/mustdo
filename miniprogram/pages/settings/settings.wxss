page {
  min-height: 100%;
  background: #f9f9f9;
}

.settings-page {
  min-height: 100vh;
  background: #f9f9f9;
  color: #1a1c1c;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.settings-navbar {
  height: 64rpx;
  padding-bottom: 16rpx;
  box-sizing: content-box;
}

.settings-navbar-content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  width: 100%;
  height: 64rpx;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.back-button:active {
  transform: scale(0.92);
  opacity: 0.65;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
}

.settings-wordmark {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.settings-content {
  padding: 48rpx 40rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.settings-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.settings-title,
.settings-subtitle {
  display: block;
}

.settings-title {
  color: #000000;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 82rpx;
  letter-spacing: -0.02em;
}

.settings-subtitle {
  color: #5d5e63;
  font-size: 30rpx;
  line-height: 40rpx;
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 48rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 132rpx;
  margin: 0;
  padding: 32rpx 48rpx;
  border-radius: 48rpx;
  background: #ffffff;
  color: #000000;
  text-align: left;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.mode-card::after {
  display: none;
}

.mode-card:active {
  transform: scale(0.96);
  opacity: 0.82;
}

.mode-title {
  color: #000000;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.mode-check {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  margin-left: 24rpx;
  opacity: 0;
}

.mode-check--visible {
  opacity: 1;
}
