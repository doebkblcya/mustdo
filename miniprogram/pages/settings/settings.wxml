<view class="settings-page">
  <view class="settings-header">
    <text class="settings-title">添加方式</text>
    <text class="settings-subtitle">语音和文字输入共用此设置</text>
  </view>

  <view class="mode-list">
    <view class="mode-card {{addMode === 'auto' ? 'mode-card--selected' : ''}}" data-mode="auto" bindtap="selectAddMode">
      <view class="mode-copy">
        <text class="mode-title">自动添加</text>
        <text class="mode-desc">AI 解析后直接保存，操作路径最短</text>
      </view>
      <view class="mode-radio">{{addMode === 'auto' ? '✓' : ''}}</view>
    </view>

    <view class="mode-card {{addMode === 'confirm' ? 'mode-card--selected' : ''}}" data-mode="confirm" bindtap="selectAddMode">
      <view class="mode-copy">
        <text class="mode-title">添加前确认</text>
        <text class="mode-desc">保存前可修改原文、内容、日期和时间</text>
      </view>
      <view class="mode-radio">{{addMode === 'confirm' ? '✓' : ''}}</view>
    </view>
  </view>

  <text class="settings-note">设置只保存在当前设备上，新设备默认使用自动添加。</text>
</view>
