<view class="settings-page">
  <view class="settings-navbar" style="padding-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="settings-navbar-content" style="height: {{navHeight}}px; padding-right: {{headerRightOffset}}px;">
      <navigator class="back-button" style="width: {{navHeight}}px; height: {{navHeight}}px;" open-type="navigateBack" aria-label="返回">
        <image class="back-icon" src="/assets/icons/png/chevron_left.png" mode="aspectFit" />
      </navigator>
      <text class="settings-wordmark">mustdo</text>
    </view>
  </view>

  <view class="settings-content">
    <view class="settings-heading">
      <text class="settings-title">添加方式</text>
    </view>

    <view class="mode-list">
      <view class="mode-panel">
        <button class="mode-item" data-mode="auto" bindtap="selectAddMode">
          <text class="mode-title">自动添加</text>
          <image class="mode-check {{addMode === 'auto' ? 'mode-check--visible' : ''}}" src="/assets/icons/png/check.png" mode="aspectFit" />
        </button>

        <view class="mode-divider"></view>

        <button class="mode-item" data-mode="confirm" bindtap="selectAddMode">
          <text class="mode-title">添加前确认</text>
          <image class="mode-check {{addMode === 'confirm' ? 'mode-check--visible' : ''}}" src="/assets/icons/png/check.png" mode="aspectFit" />
        </button>
      </view>
    </view>

    <view class="quota-heading">
      <text class="quota-title">使用额度</text>
    </view>

    <view wx:if="{{quotaLoading}}" class="quota-state">正在加载额度…</view>

    <view wx:elif="{{quotaError}}" class="quota-state quota-state--error">
      <text class="quota-error-text">{{quotaError}}</text>
      <button class="quota-retry" bindtap="retryQuota">重试</button>
    </view>

    <view wx:elif="{{quotaView}}" class="quota-list">
      <view class="quota-panel">
        <view class="quota-item {{quotaView.asr.enabled ? '' : 'quota-item--disabled'}}">
          <view class="quota-item-header">
            <text class="quota-item-title">语音识别</text>
            <text class="quota-value">{{quotaView.asr.value}}</text>
          </view>
          <view wx:if="{{quotaView.asr.showProgress}}" class="quota-progress">
            <view class="quota-progress-fill" style="width: {{quotaView.asr.usedPercent}}%;" />
          </view>
        </view>

        <view class="quota-divider"></view>

        <view class="quota-item {{quotaView.ai.enabled ? '' : 'quota-item--disabled'}}">
          <view class="quota-item-header">
            <text class="quota-item-title">AI 处理</text>
            <text class="quota-value">{{quotaView.ai.value}}</text>
          </view>
          <view wx:if="{{quotaView.ai.showProgress}}" class="quota-progress">
            <view class="quota-progress-fill" style="width: {{quotaView.ai.usedPercent}}%;" />
          </view>
        </view>
      </view>
    </view>

    <view class="help-heading">
      <text class="help-title">帮助</text>
    </view>

    <view class="help-list">
      <button class="help-item" bindtap="openGuide">
        <view class="help-leading">
          <image class="help-icon" src="/assets/icons/png/info.png" mode="aspectFit" />
          <text class="help-item-title">使用指南</text>
        </view>
        <image class="help-chevron" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
      </button>
    </view>
  </view>

  <quick-guide visible="{{guideVisible}}" bind:close="closeGuide" />
</view>
