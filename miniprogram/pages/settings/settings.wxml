<view class="settings-page">
  <view class="settings-navbar" style="padding-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="settings-navbar-content" style="height: {{navHeight}}px; padding-right: {{headerRightOffset}}px;">
      <navigator class="back-button" style="width: {{navHeight}}px; height: {{navHeight}}px;" open-type="navigateBack" aria-label="返回">
        <image class="back-icon" src="/assets/icons/png/chevron_left.png" mode="aspectFit" />
      </navigator>
      <text class="settings-wordmark">mustdo</text>
    </view>
  </view>

  <view class="settings-content">
    <view class="settings-heading">
      <text class="settings-title">添加方式</text>
      <text class="settings-subtitle">语音和文字输入共用此设置</text>
    </view>

    <view class="mode-list">
      <button class="mode-card" data-mode="auto" bindtap="selectAddMode">
        <text class="mode-title">自动添加</text>
        <image class="mode-check {{addMode === 'auto' ? 'mode-check--visible' : ''}}" src="/assets/icons/png/check.png" mode="aspectFit" />
      </button>

      <button class="mode-card" data-mode="confirm" bindtap="selectAddMode">
        <text class="mode-title">添加前确认</text>
        <image class="mode-check {{addMode === 'confirm' ? 'mode-check--visible' : ''}}" src="/assets/icons/png/check.png" mode="aspectFit" />
      </button>
    </view>
  </view>
</view>
