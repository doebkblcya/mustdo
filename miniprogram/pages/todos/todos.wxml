<view class="todos-page page {{composerTall && composerMode === 'keyboard' ? 'todos-page--composer-tall' : ''}}">
  <!-- Section 1: Header -->
  <view class="section-card section-header">
    <view class="app-header">
      <view>
        <text class="wordmark">mustdo</text>
      </view>
      <view class="header-actions">
        <button class="settings-button" bindtap="openSettings" aria-label="设置">
          <text class="settings-icon">设置</text>
        </button>
        <button class="trash-button" bindtap="openTrash" aria-label="垃圾桶">
          <view class="trash-icon">
            <view class="trash-lid"></view>
            <view class="trash-bin"></view>
          </view>
        </button>
        <button class="visibility-button" bindtap="toggleShowCompleted">{{showCompleted ? '隐藏已完成' : '显示已完成'}}</button>
      </view>
    </view>
  </view>

  <!-- Section 2: Content -->
  <view class="section-card section-body">
    <view class="tab-section">
    <view class="tabs">
    <view class="tab-pill" style="width: {{pillWidth}}px; transform: translateX({{pillX}}px);"></view>
    <button class="tab {{activeView === 'today' ? 'active' : ''}}" data-view="today" bindtap="switchView">
      <text class="tab-label">今天</text>
    </button>
    <button class="tab {{activeView === 'tomorrow' ? 'active' : ''}}" data-view="tomorrow" bindtap="switchView">
      <text class="tab-label">明天</text>
    </button>
    <button class="tab {{activeView === 'upcoming' ? 'active' : ''}}" data-view="upcoming" bindtap="switchView">
      <text class="tab-label">{{upcomingLabel}}</text>
    </button>
  </view>

  <!-- Calendar (expandable on 后续 tab) -->
  <view wx:if="{{calendarVisible}}" class="calendar-wrap" style="height: {{calHeight}}px;">
    <view class="calendar">
      <view class="cal-header">
        <view class="cal-nav" data-delta="-1" bindtap="shiftCalendarMonth">
          <view class="cal-arrow cal-arrow--left"></view>
        </view>
        <text class="cal-title">{{calTitle}}</text>
        <view class="cal-nav" data-delta="1" bindtap="shiftCalendarMonth">
          <view class="cal-arrow cal-arrow--right"></view>
        </view>
      </view>
      <view class="cal-weekdays">
        <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="cal-weekday">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="weekIndex" class="cal-week">
          <view
            wx:for="{{week.days}}"
            wx:for-item="cell"
            wx:key="key"
            class="cal-day {{cell.inMonth ? '' : 'cal-day--dim'}} {{cell.beforeToday ? 'cal-day--past' : ''}} {{cell.isSelected ? 'cal-day--selected' : ''}}"
            data-date="{{cell.dateStr}}"
            data-before="{{cell.beforeToday}}"
            data-inmonth="{{cell.inMonth}}"
            bindtap="onCalDayTap"
          >
            <text class="cal-day-num">{{cell.inMonth ? cell.day : ''}}</text>
            <view wx:if="{{cell.hasDot}}" class="cal-dot"></view>
          </view>
        </view>
      </view>
    </view>
    </view>
    </view>

  <view wx:if="{{activeView === 'today' && todayHasPending}}" class="organize-switch">
    <view class="organize-seg {{organizeMode ? '' : 'organize-seg--active'}}" bindtap="onOrganizeDefaultTap">默认</view>
    <view class="organize-seg {{organizeMode ? 'organize-seg--active' : ''}}" bindtap="toggleOrganize">AI 整理</view>
  </view>

  <view class="todo-list">
    <!-- Skeleton loading -->
    <block wx:if="{{loading}}">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-line" style="width:52rpx;height:52rpx;border-radius:50%;flex:0 0 52rpx;"></view>
        <view style="flex:1;display:flex;flex-direction:column;gap:14rpx;">
          <view class="skeleton-line" style="width:70%;"></view>
          <view class="skeleton-line" style="width:44%;"></view>
        </view>
      </view>
    </block>

    <!-- AI organizing state (today view only) -->
    <view wx:elif="{{organizing && activeView === 'today'}}" class="organize-loading">
      <text class="organize-loading-text">AI 正在整理当前事项…</text>
    </view>

    <!-- Error state -->
    <view wx:elif="{{error}}" class="empty-state">
      <text class="empty-icon">⚠️</text>
      <text class="empty-title">加载失败</text>
      <text class="empty-desc">{{error}}</text>
      <button class="primary-button retry-button" bindtap="loadTodos">重试</button>
    </view>

    <!-- Empty state -->
    <view wx:elif="{{items.length === 0}}" class="empty-state">
      <view class="empty-line"></view>
    </view>

    <!-- Todo items (cards + AI group headers) -->
    <block wx:else>
      <view wx:for="{{items}}" wx:key="key">
        <!-- AI organize: group title row -->
        <view wx:if="{{item.__header}}" class="organize-group-title">{{item.name}}</view>
        <!-- Regular todo card -->
        <view wx:else class="todo-swipe-wrapper {{item.deleting ? 'deleting' : ''}}">
          <view class="swipe-zone swipe-zone--pin">
            <view class="swipe-icon-img swipe-icon--pin"></view>
          </view>
          <view
            class="todo-item {{item.status === 'done' ? 'done' : ''}} {{item.pinned ? 'pinned' : ''}}"
            style="transform: translateX({{item.swipeX || 0}}px);"
            data-index="{{index}}"
            bindtouchstart="onItemTouchStart"
            bindtouchmove="onItemTouchMove"
            bindtouchend="onItemTouchEnd"
          >
            <button
              class="check-button"
              style="transform: scale({{item.checkScale || 1}});"
              data-id="{{item.id}}"
              data-status="{{item.status}}"
              data-index="{{index}}"
              bindtap="toggleTodo"
            >
              {{item.status === 'done' ? '✓' : ''}}
            </button>
            <view class="todo-content">
              <text class="todo-title">{{item.content}}</text>
              <text class="todo-meta">{{item.meta}}</text>
              <text wx:if="{{item.reminder}}" class="todo-reminder">提醒 {{formatRemindAt(item.reminder.remind_at)}}</text>
            </view>
            <button
              wx:if="{{item.status === 'pending' && activeView === 'today'}}"
              class="tomorrow-btn"
              data-id="{{item.id}}"
              bindtap="moveToTomorrow"
            >
              <view class="tomorrow-icon"></view>
            </button>
            <button
              wx:if="{{item.status === 'pending'}}"
              class="remind-btn {{item.reminder ? 'remind-btn--on' : ''}}"
              data-id="{{item.id}}"
              bindtap="openReminderPanel"
              aria-label="设置提醒"
            >
              <view class="remind-icon"></view>
            </button>
            <button class="edit-btn" data-id="{{item.id}}" bindtap="editTodo">
              <view class="edit-icon">
                <view class="edit-frame"></view>
                <view class="edit-stroke"></view>
              </view>
            </button>
          </view>
          <view class="swipe-zone swipe-zone--delete">
            <view class="swipe-icon-img swipe-icon--trash"></view>
          </view>
        </view>
      </view>
    </block>
  </view>
  </view>

  <processing-panel
    id="processingPanel"
    today-date="{{todayDate}}"
    bind:statechange="onPanelStateChange"
    bind:saved="onPanelSaved"
    bind:rerecord="onPanelRerecord"
  />

  <!-- Composer: one state model, separate compact/expanded geometry. -->
  <view
    class="input-dock {{expanded ? 'input-dock--expanded' : ''}} {{composerKeyboardHeight > 0 ? 'input-dock--keyboard-visible' : ''}}"
    style="{{expanded ? ('bottom: ' + composerKeyboardHeight + 'px;') : ''}}"
  >
    <view
      class="composer-surface {{expanded ? 'composer-surface--expanded' : ''}} {{recording ? 'composer-surface--recording' : ''}}"
      style="{{expanded ? ('top: ' + expandTop + 'px; bottom: 0;') : ('transform: translateY(' + composerLift + 'px);')}}"
    >
      <view
        wx:if="{{composerMode === 'keyboard'}}"
        class="composer-editor"
      >
        <!-- Mutually exclusive native nodes prevent compact scrollTop leaking
             into the expanded editor. Both use the same text/cursor state. -->
        <textarea
          wx:if="{{expanded}}"
          class="composer-textarea composer-textarea--expanded"
          value="{{composerText}}"
          cursor="{{composerCursor}}"
          placeholder="{{composerPlaceholder}}"
          placeholder-class="composer-placeholder"
          confirm-type="{{isIOS ? 'send' : 'return'}}"
          focus="{{composerFocus}}"
          fixed="{{true}}"
          adjust-position="{{false}}"
          auto-height="{{false}}"
          hold-keyboard="{{true}}"
          disable-default-padding="{{true}}"
          show-confirm-bar="{{false}}"
          maxlength="4000"
          bindinput="onComposerInput"
          bindconfirm="onComposerConfirm"
          bindblur="onComposerBlur"
        />
        <textarea
          wx:else
          class="composer-textarea composer-textarea--compact {{composerOverflow ? 'composer-textarea--overflow' : ''}}"
          value="{{composerText}}"
          cursor="{{composerCursor}}"
          placeholder="{{composerPlaceholder}}"
          placeholder-class="composer-placeholder"
          confirm-type="{{isIOS ? 'send' : 'return'}}"
          focus="{{composerFocus}}"
          fixed="{{true}}"
          adjust-position="{{false}}"
          auto-height="{{!composerOverflow}}"
          hold-keyboard="{{true}}"
          disable-default-padding="{{true}}"
          show-confirm-bar="{{false}}"
          maxlength="4000"
          bindinput="onComposerInput"
          bindlinechange="onComposerLineChange"
          bindconfirm="onComposerConfirm"
          bindblur="onComposerBlur"
        />
      </view>

      <view
        wx:else
        class="composer-editor composer-editor--voice"
        bindtouchstart="onComposerTouchStart"
        bindtouchmove="onComposerTouchMove"
        bindtouchend="onComposerTouchEnd"
        bindtouchcancel="onComposerTouchCancel"
      >
        <text class="composer-hold-text">{{recording ? (voiceCancelHover ? '松开取消' : '松开完成，上移取消') : '按住说话'}}</text>
      </view>

      <!-- Small outlined capsule; expanded mode repositions it over the editor. -->
      <view class="composer-action-group">
        <view
          wx:if="{{composerMode === 'keyboard' && !isIOS && composerText}}"
          class="composer-action composer-action--send"
          bindtap="submitComposerText"
        >
          <view class="send-icon"></view>
        </view>
        <view
          class="composer-action composer-action--toggle {{recording ? 'composer-action--disabled' : ''}}"
          bindtap="onComposerToggle"
        >
          <view wx:if="{{composerMode === 'keyboard'}}" class="wave-icon">
            <view class="wave-arc wave-arc--1"></view>
            <view class="wave-arc wave-arc--2"></view>
            <view class="wave-arc wave-arc--3"></view>
          </view>
          <view wx:else class="kb-icon"></view>
        </view>
      </view>

      <!-- Same visual language as the action dock; always owned by the surface. -->
      <view
        wx:if="{{expanded}}"
        class="composer-corner-control composer-corner-control--expanded"
        bindtap="closeExpand"
      >
        <view class="resize-icon resize-icon--collapse"></view>
      </view>
      <view
        wx:elif="{{expandVisible}}"
        class="composer-corner-control"
        bindtap="openExpand"
      >
        <view class="resize-icon resize-icon--expand"></view>
      </view>
    </view>
  </view>

  <!-- Edit bottom sheet -->
  <view
    wx:if="{{editVisible}}"
    class="sheet-mask"
    style="opacity: {{maskOpacity}};"
    catchtouchmove="noop"
    bindtap="onMaskTap"
  >
    <view
      class="edit-sheet"
      style="transform: translateY({{sheetTranslateY}}px);"
    >
      <!-- Drag handle -->
      <view
        class="sheet-handle-area"
        catchtouchstart="onSheetTouchStart"
        catchtouchmove="onSheetTouchMove"
        catchtouchend="onSheetTouchEnd"
      >
        <view class="sheet-handle"></view>
      </view>

      <view class="sheet-head">
        <text class="sheet-title">{{sheetMode === 'reminder' ? '设置提醒' : '修改待办'}}</text>
        <button class="sheet-close" bindtap="cancelEdit">
          <view class="sheet-close-icon"></view>
        </button>
      </view>

      <!-- 修改待办 -->
      <block wx:if="{{sheetMode === 'edit'}}">
      <input
        class="field edit-field"
        value="{{editContent}}"
        placeholder="待办内容"
        placeholder-class="edit-placeholder"
        confirm-type="done"
        bindinput="onEditContentInput"
      />

      <view class="edit-row">
        <text class="edit-label">日期</text>
        <picker mode="date" value="{{editDate}}" start="{{todayDate}}" bindchange="onEditDateChange">
          <view class="picker-value">{{editDate}}</view>
        </picker>
      </view>

      <view class="edit-row">
        <text class="edit-label">时间</text>
        <switch checked="{{editUseTime}}" color="#1d1d1f" bindchange="onEditUseTimeChange" />
      </view>

      <picker wx:if="{{editUseTime}}" mode="time" value="{{editTime}}" bindchange="onEditTimeChange">
        <view class="time-picker">{{editTime}}</view>
      </picker>

      <button class="primary-button save-button" loading="{{editSubmitting}}" bindtap="submitEdit">保存</button>
      </block>

      <!-- 设置提醒 -->
      <block wx:else>
        <view class="remind-summary">
          <text class="remind-summary-title">{{remindTodoContent}}</text>
          <text class="remind-summary-meta">{{remindTodoDue}}</text>
        </view>

        <view class="remind-options">
          <view
            wx:for="{{remindOptions}}"
            wx:key="label"
            class="remind-option {{index === remindSelected ? 'remind-option--active' : ''}} {{item.invalid ? 'remind-option--disabled' : ''}}"
            data-index="{{index}}"
            bindtap="onRemindOptionTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.timeText}}" class="remind-option-time">{{item.timeText}}</text>
          </view>
        </view>

        <view wx:if="{{remindSelected === remindOptions.length - 1}}" class="remind-custom">
          <view class="edit-row">
            <text class="edit-label">日期</text>
            <picker mode="date" value="{{remindCustomDate}}" start="{{todayDate}}" bindchange="onRemindCustomDateChange">
              <view class="picker-value">{{remindCustomDate}}</view>
            </picker>
          </view>
          <view class="edit-row">
            <text class="edit-label">时间</text>
            <picker mode="time" value="{{remindCustomTime}}" bindchange="onRemindCustomTimeChange">
              <view class="time-picker">{{remindCustomTime}}</view>
            </picker>
          </view>
        </view>

        <view wx:if="{{remindHasActive}}" class="remind-cancel" bindtap="cancelReminderFlow">取消当前提醒</view>
        <button class="primary-button save-button" loading="{{remindSubmitting}}" bindtap="submitReminder">确认提醒</button>
      </block>
    </view>
  </view>
</view>
