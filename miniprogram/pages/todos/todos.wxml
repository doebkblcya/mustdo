<view class="todos-page {{composerTall && composerMode === 'keyboard' ? 'todos-page--composer-tall' : ''}}">
  <!-- 自定义顶栏 -->
  <view class="app-header" style="padding-top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{headerRightOffset}}px;">
    <text class="wordmark">mustdo</text>
    <view class="header-actions">
      <button class="header-button settings-button" style="width: {{navHeight}}px; height: {{navHeight}}px;" bindtap="openSettings" aria-label="设置">
        <image class="header-icon" src="/assets/icons/png/settings.png" mode="aspectFit" />
      </button>
      <button class="header-button trash-button" style="width: {{navHeight}}px; height: {{navHeight}}px;" bindtap="openTrash" aria-label="垃圾桶">
        <image class="header-icon" src="/assets/icons/png/delete.png" mode="aspectFit" />
      </button>
    </view>
  </view>

  <view class="todos-content">
    <view class="tab-section">
      <view class="tab-row" bindtouchstart="onTabRowTouchStart" bindtouchmove="onTabRowTouchMove" bindtouchend="onTabRowTouchEnd" bindtouchcancel="onTabRowTouchEnd">
        <view class="tabs">
          <button class="tab {{activeView === 'today' ? 'active' : ''}}" data-view="today" bindtap="switchView">
            <text class="tab-label">今天</text>
          </button>
          <button class="tab {{activeView === 'tomorrow' ? 'active' : ''}}" data-view="tomorrow" bindtap="switchView">
            <text class="tab-label">明天</text>
          </button>
          <button class="tab {{activeView === 'upcoming' ? 'active' : ''}}" data-view="upcoming" bindtap="switchView">
            <text class="tab-label">{{upcomingLabel}}</text>
          </button>
        </view>
        <view class="list-tools">
          <button
            class="organize-button {{organizeMode ? 'organize-button--active' : ''}}"
            bindtap="toggleOrganize"
            disabled="{{activeView !== 'today' || !todayHasPending}}"
          >
            <image class="sparkle-icon" src="/assets/icons/png/auto_awesome.png" mode="aspectFit" />
            <text>AI 整理</text>
          </button>
          <button class="visibility-button" bindtap="toggleShowCompleted" aria-label="{{showCompleted ? '隐藏已完成' : '显示已完成'}}">
            <image class="visibility-icon" src="{{showCompleted ? '/assets/icons/png/visibility.png' : '/assets/icons/png/visibility_off.png'}}" mode="aspectFit" />
          </button>
        </view>
      </view>

  <!-- Calendar (expandable on 后续 tab) -->
  <view wx:if="{{calendarVisible}}" class="calendar-wrap" style="height: {{calHeight}}px;">
    <view class="calendar">
      <view class="cal-header">
        <view class="cal-nav" data-delta="-1" bindtap="shiftCalendarMonth">
          <image class="cal-arrow" src="/assets/icons/png/chevron_left.png" mode="aspectFit" />
        </view>
        <text class="cal-title">{{calTitle}}</text>
        <view class="cal-nav" data-delta="1" bindtap="shiftCalendarMonth">
          <image class="cal-arrow" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
        </view>
      </view>
      <view class="cal-weekdays">
        <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="cal-weekday">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="weekIndex" class="cal-week">
          <view
            wx:for="{{week.days}}"
            wx:for-item="cell"
            wx:key="key"
            class="cal-day {{cell.inMonth ? '' : 'cal-day--dim'}} {{cell.beforeToday ? 'cal-day--past' : ''}} {{cell.isSelected ? 'cal-day--selected' : ''}}"
            data-date="{{cell.dateStr}}"
            data-before="{{cell.beforeToday}}"
            data-inmonth="{{cell.inMonth}}"
            bindtap="onCalDayTap"
          >
            <text class="cal-day-num">{{cell.inMonth ? cell.day : ''}}</text>
            <view wx:if="{{cell.hasDot}}" class="cal-dot"></view>
          </view>
        </view>
      </view>
    </view>
    </view>
    </view>

  <scroll-view
    class="todo-scroll"
    scroll-y="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
  <view class="todo-list">
    <!-- Loading skeleton mirrors the final pill-card geometry. -->
    <view wx:if="{{loading}}" class="skeleton-list" aria-label="正在加载待办">
      <view wx:for="{{skeletonItems}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-check skeleton-shimmer"></view>
        <view class="skeleton-copy">
          <view class="skeleton-line skeleton-line--title skeleton-line--title-{{index % 4}}"></view>
          <view class="skeleton-line skeleton-line--meta skeleton-line--meta-{{index % 4}}"></view>
        </view>
        <view class="skeleton-actions">
          <view class="skeleton-action skeleton-shimmer"></view>
          <view class="skeleton-action skeleton-shimmer"></view>
        </view>
      </view>
    </view>

    <!-- AI organizing state (today view only) -->
    <view wx:elif="{{organizing && activeView === 'today'}}" class="organize-loading">
      <image class="organize-loading-icon" src="/assets/icons/png/progress_activity.png" mode="aspectFit" />
      <text class="organize-loading-title">正在整理…</text>
    </view>

    <!-- Error state -->
    <view wx:elif="{{error}}" class="state-view state-view--error">
      <view class="state-icon-shell state-icon-shell--error">
        <image class="state-icon" src="/assets/icons/png/error_red.png" mode="aspectFit" />
      </view>
      <text class="state-title">加载失败</text>
      <button class="state-primary-action" bindtap="loadTodos">
        <image class="state-action-icon" src="/assets/icons/png/refresh_white.png" mode="aspectFit" />
        <text>重试</text>
      </button>
    </view>

    <!-- Empty state -->
    <view wx:elif="{{items.length === 0}}" class="empty-state-minimal">
      <view class="empty-line"></view>
    </view>

    <!-- Todo items (cards + AI group headers) -->
    <block wx:else>
      <view wx:for="{{items}}" wx:key="key">
        <!-- AI organize: group title row -->
        <view wx:if="{{item.__header}}" class="organize-group-title">{{item.name}}</view>
        <!-- Regular todo card -->
        <view wx:else class="todo-swipe-wrapper {{item.deletePending ? 'delete-pending' : ''}} {{item.deleting ? 'deleting' : ''}}">
          <view class="swipe-actions">
            <button
              wx:if="{{item.status === 'pending' && item.due_date === todayDate}}"
              class="swipe-action swipe-action--tomorrow"
              data-id="{{item.id}}"
              data-index="{{index}}"
              bindtap="onSwipeMoveTomorrow"
              aria-label="移到明天"
            >
              <image class="swipe-action-icon" src="/assets/icons/png/event_upcoming.png" mode="aspectFit" />
            </button>
            <button
              class="swipe-action swipe-action--pin"
              data-id="{{item.id}}"
              data-index="{{index}}"
              bindtap="onSwipePin"
              aria-label="{{item.pinned ? '取消置顶' : '置顶'}}"
            >
              <image class="swipe-action-icon" src="/assets/icons/png/keep.png" mode="aspectFit" />
            </button>
            <button
              class="swipe-action swipe-action--delete"
              data-id="{{item.id}}"
              data-index="{{index}}"
              bindtap="onSwipeDelete"
              aria-label="删除"
            >
              <image class="swipe-action-icon" src="/assets/icons/png/delete_error.png" mode="aspectFit" />
            </button>
          </view>
          <view
            class="todo-item {{item.status === 'done' ? 'done' : ''}} {{item.pinned ? 'pinned' : ''}}"
            style="transform: translateX({{item.swipeX || 0}}px);"
            data-index="{{index}}"
            bindtouchstart="onItemTouchStart"
            bindtouchmove="onItemTouchMove"
            bindtouchend="onItemTouchEnd"
            bindtouchcancel="onItemTouchCancel"
          >
            <button
              class="check-button"
              style="transform: scale({{item.checkScale || 1}});"
              data-id="{{item.id}}"
              data-status="{{item.status}}"
              data-index="{{index}}"
              bindtap="toggleTodo"
            >
              <image wx:if="{{item.status === 'done'}}" class="check-icon" src="/assets/icons/png/check_white.png" mode="aspectFit" />
            </button>
            <view class="todo-content">
              <text class="todo-title">{{item.content}}</text>
              <text class="todo-meta">{{item.meta}}</text>
            </view>
            <button
              wx:if="{{item.status === 'pending'}}"
              class="remind-btn {{item.reminder ? 'remind-btn--on' : ''}}"
              data-id="{{item.id}}"
              bindtap="openReminderPanel"
              aria-label="设置提醒"
            >
              <image
                class="todo-action-icon"
                src="{{item.reminder ? '/assets/icons/png/notifications_active_fill.png' : '/assets/icons/png/notifications.png'}}"
                mode="aspectFit"
              />
            </button>
            <button class="edit-btn" data-id="{{item.id}}" bindtap="editTodo">
              <image class="todo-action-icon" src="/assets/icons/png/edit.png" mode="aspectFit" />
            </button>
          </view>
        </view>
      </view>
    </block>
  </view>
  </scroll-view>
  </view>

  <processing-panel
    id="processingPanel"
    today-date="{{todayDate}}"
    bind:statechange="onPanelStateChange"
    bind:saved="onPanelSaved"
    bind:rerecord="onPanelRerecord"
  />

  <!-- Microphone permission is actionable, so it uses a real modal instead of a toast. -->
  <view wx:if="{{recordPermissionVisible}}" class="permission-mask" catchtouchmove="noop">
    <view class="permission-card">
      <view class="permission-icon-shell">
        <image class="permission-icon" src="/assets/icons/png/mic_off.png" mode="aspectFit" />
      </view>
      <text class="permission-title">需要麦克风权限</text>
      <button class="permission-primary" bindtap="openRecordSettings">去设置</button>
      <button class="permission-secondary" bindtap="closeRecordPermission">取消</button>
    </view>
  </view>

  <!-- Composer: one state model, separate compact/expanded geometry. -->
  <view
    class="input-dock {{expanded ? 'input-dock--expanded' : ''}} {{composerKeyboardHeight > 0 ? 'input-dock--keyboard-visible' : ''}}"
    style="{{expanded ? ('bottom: ' + composerKeyboardHeight + 'px;') : ''}}"
  >
    <view
      class="composer-surface {{expanded ? 'composer-surface--expanded' : ''}} {{recording ? 'composer-surface--recording' : ''}}"
      style="{{expanded ? ('top: ' + expandTop + 'px; bottom: 0;') : ('transform: translateY(' + composerLift + 'px);')}}"
    >
      <view
        wx:if="{{composerMode === 'keyboard'}}"
        class="composer-editor"
      >
        <!-- Mutually exclusive native nodes prevent compact scrollTop leaking
             into the expanded editor. Both use the same text/cursor state. -->
        <textarea
          wx:if="{{expanded}}"
          class="composer-textarea composer-textarea--expanded"
          value="{{composerText}}"
          cursor="{{composerCursor}}"
          placeholder="{{composerPlaceholder}}"
          placeholder-class="composer-placeholder"
          confirm-type="{{isIOS ? 'send' : 'return'}}"
          focus="{{composerFocus}}"
          fixed="{{true}}"
          adjust-position="{{false}}"
          auto-height="{{false}}"
          hold-keyboard="{{true}}"
          disable-default-padding="{{true}}"
          show-confirm-bar="{{false}}"
          maxlength="4000"
          bindinput="onComposerInput"
          bindconfirm="onComposerConfirm"
          bindblur="onComposerBlur"
        />
        <textarea
          wx:else
          class="composer-textarea composer-textarea--compact {{composerOverflow ? 'composer-textarea--overflow' : ''}}"
          value="{{composerText}}"
          cursor="{{composerCursor}}"
          placeholder="{{composerPlaceholder}}"
          placeholder-class="composer-placeholder"
          confirm-type="{{isIOS ? 'send' : 'return'}}"
          focus="{{composerFocus}}"
          fixed="{{true}}"
          adjust-position="{{false}}"
          auto-height="{{!composerOverflow}}"
          hold-keyboard="{{true}}"
          disable-default-padding="{{true}}"
          show-confirm-bar="{{false}}"
          maxlength="4000"
          bindinput="onComposerInput"
          bindlinechange="onComposerLineChange"
          bindconfirm="onComposerConfirm"
          bindblur="onComposerBlur"
        />
      </view>

      <view
        wx:else
        class="composer-editor composer-editor--voice"
        bindtouchstart="onComposerTouchStart"
        catchtouchmove="onComposerTouchMove"
        bindtouchend="onComposerTouchEnd"
        bindtouchcancel="onComposerTouchCancel"
      >
        <text class="composer-hold-text">{{recording ? (voiceCancelHover ? '松开取消' : '松开完成，上移取消') : '按住说话'}}</text>
      </view>

      <!-- Small outlined capsule; expanded mode repositions it over the editor. -->
      <view class="composer-action-group">
        <view
          wx:if="{{composerMode === 'keyboard' && !isIOS && composerText}}"
          class="composer-action composer-action--send"
          bindtap="submitComposerText"
        >
          <image class="composer-icon" src="/assets/icons/png/send.png" mode="aspectFit" />
        </view>
        <view
          class="composer-action composer-action--toggle {{recording ? 'composer-action--disabled' : ''}}"
          bindtap="onComposerToggle"
        >
          <image
            class="composer-icon"
            src="{{composerMode === 'keyboard' ? '/assets/icons/png/mic.png' : '/assets/icons/png/keyboard_alt.png'}}"
            mode="aspectFit"
          />
        </view>
      </view>

      <!-- Same visual language as the action dock; always owned by the surface. -->
      <view
        wx:if="{{expanded}}"
        class="composer-corner-control composer-corner-control--expanded"
        bindtap="closeExpand"
      >
        <image class="resize-icon" src="/assets/icons/png/close_fullscreen.png" mode="aspectFit" />
      </view>
      <view
        wx:elif="{{expandVisible}}"
        class="composer-corner-control"
        bindtap="openExpand"
      >
        <image class="resize-icon" src="/assets/icons/png/open_in_full.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Edit bottom sheet -->
  <view
    wx:if="{{editVisible}}"
    class="sheet-mask"
    style="opacity: {{maskOpacity}};"
    bindtap="onMaskTap"
  >
    <view
      class="edit-sheet edit-sheet--{{sheetMode}}"
      style="transform: translateY({{sheetTranslateY}}px);"
    >
      <view
        class="sheet-handle-area"
        catchtouchstart="onSheetTouchStart"
        catchtouchmove="onSheetTouchMove"
        catchtouchend="onSheetTouchEnd"
      >
        <view class="sheet-handle"></view>
      </view>

      <view class="sheet-head">
        <view class="sheet-head-copy">
          <text class="sheet-title">{{sheetMode === 'reminder' ? '设置提醒' : '编辑待办'}}</text>
          <text class="sheet-subtitle">{{sheetMode === 'reminder' ? '选择接收微信提醒的时间' : '调整待办内容和安排'}}</text>
        </view>
        <button class="sheet-close" bindtap="cancelEdit" aria-label="关闭">
          <image class="sheet-close-icon" src="/assets/icons/png/close.png" mode="aspectFit" />
        </button>
      </view>

      <scroll-view
        class="sheet-scroll"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <view class="sheet-scroll-content">
      <block wx:if="{{sheetMode === 'edit'}}">
        <view class="sheet-section">
          <text class="sheet-section-label">待办内容</text>
          <input
            class="edit-task-field"
            value="{{editContent}}"
            placeholder="输入待办内容"
            placeholder-class="edit-placeholder"
            confirm-type="done"
            cursor-spacing="24"
            bindinput="onEditContentInput"
          />
        </view>

        <view class="sheet-section">
          <text class="sheet-section-label">安排</text>
          <view class="schedule-card">
            <picker class="setting-picker" mode="date" value="{{editDate}}" start="{{todayDate}}" bindchange="onEditDateChange">
              <view class="sheet-setting-row">
                <view class="setting-leading">
                  <view class="setting-icon-wrap">
                    <image class="setting-icon" src="/assets/icons/png/calendar_month.png" mode="aspectFit" />
                  </view>
                  <view class="setting-copy">
                    <text class="setting-title">日期</text>
                    <text class="setting-caption">待办到期日期</text>
                  </view>
                </view>
                <view class="setting-value-wrap">
                  <text class="setting-value">{{editDate}}</text>
                  <image class="setting-chevron" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
                </view>
              </view>
            </picker>

            <view class="sheet-divider"></view>

            <view class="sheet-setting-row" bindtap="onEditTimeToggle">
              <view class="setting-leading">
                <view class="setting-icon-wrap">
                  <image class="setting-icon" src="/assets/icons/png/schedule.png" mode="aspectFit" />
                </view>
                <view class="setting-copy">
                  <text class="setting-title">具体时间</text>
                  <text class="setting-caption">{{editUseTime ? '已设置具体时间' : '不设置具体时间'}}</text>
                </view>
              </view>
              <view class="sheet-switch {{editUseTime ? 'sheet-switch--on' : ''}}">
                <view class="sheet-switch-thumb"></view>
              </view>
            </view>

            <block wx:if="{{editUseTime}}">
              <view class="sheet-divider sheet-divider--indented"></view>
              <picker class="setting-picker" mode="time" value="{{editTime}}" bindchange="onEditTimeChange">
                <view class="sheet-setting-row sheet-setting-row--time">
                  <text class="setting-title">时间</text>
                  <view class="setting-value-wrap">
                    <text class="setting-value setting-value--strong">{{editTime}}</text>
                    <image class="setting-chevron" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
                  </view>
                </view>
              </picker>
            </block>
          </view>
        </view>

      </block>

      <block wx:else>
        <view class="remind-summary">
          <view class="remind-summary-icon-wrap">
            <image class="remind-summary-icon" src="/assets/icons/png/notifications.png" mode="aspectFit" />
          </view>
          <view class="remind-summary-copy">
            <text class="remind-summary-title">{{remindTodoContent}}</text>
            <text class="remind-summary-meta">{{remindTodoDue}}</text>
          </view>
        </view>

        <text class="sheet-section-label remind-section-label">提醒时间</text>
        <view class="remind-options">
          <view
            wx:for="{{remindOptions}}"
            wx:key="label"
            class="remind-option {{index === remindSelected ? 'remind-option--active' : ''}} {{item.invalid ? 'remind-option--disabled' : ''}}"
            data-index="{{index}}"
            bindtap="onRemindOptionTap"
          >
            <text class="remind-option-label">{{item.label}}</text>
            <view class="remind-option-end">
              <text wx:if="{{item.timeText}}" class="remind-option-time">{{item.timeText}}</text>
              <view class="remind-radio {{index === remindSelected ? 'remind-radio--active' : ''}}">
                <image wx:if="{{index === remindSelected}}" class="remind-radio-check" src="/assets/icons/png/check_white.png" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{remindSelected === remindOptions.length - 1}}" class="remind-custom">
          <picker class="remind-custom-picker" mode="date" value="{{remindCustomDate}}" start="{{todayDate}}" bindchange="onRemindCustomDateChange">
            <view class="remind-custom-field">
              <image class="remind-custom-icon" src="/assets/icons/png/calendar_month.png" mode="aspectFit" />
              <view class="remind-custom-copy">
                <text class="remind-custom-label">日期</text>
                <text class="remind-custom-value">{{remindCustomDate}}</text>
              </view>
            </view>
          </picker>
          <picker class="remind-custom-picker" mode="time" value="{{remindCustomTime}}" bindchange="onRemindCustomTimeChange">
            <view class="remind-custom-field">
              <image class="remind-custom-icon" src="/assets/icons/png/schedule.png" mode="aspectFit" />
              <view class="remind-custom-copy">
                <text class="remind-custom-label">时间</text>
                <text class="remind-custom-value">{{remindCustomTime}}</text>
              </view>
            </view>
          </picker>
        </view>

      </block>
        </view>
      </scroll-view>

      <view class="sheet-footer">
        <button
          wx:if="{{sheetMode === 'reminder' && remindHasActive}}"
          class="remind-cancel"
          bindtap="cancelReminderFlow"
        >取消当前提醒</button>
        <button
          wx:if="{{sheetMode === 'edit'}}"
          class="primary-button save-button"
          loading="{{editSubmitting}}"
          bindtap="submitEdit"
        >保存修改</button>
        <button
          wx:else
          class="primary-button save-button"
          loading="{{remindSubmitting}}"
          bindtap="submitReminder"
        >确认提醒</button>
      </view>
    </view>
  </view>
</view>
