/*
 * Todos — Main list & interactions
 * Apple Design · Balanced proportions · Consistent with auth
 */

/* ================================================================
   Page
   ================================================================ */

.todos-page {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ================================================================
   Section cards — three-section layout
   Material weight encodes hierarchy (§12):
     Header (small) → lightest lift
     Body   (large) → thicker surface, deeper shadow
     Voice  (dark)  → heaviest, anchors the page
   ================================================================ */

.section-card {
  border-radius: 28rpx;
  background: #ffffff;
}

/* Header — smallest surface, lightest elevation */
.section-header {
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.8);
}

/* Body — main content, thicker surface, deeper shadow */
.section-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 20rpx;
  overflow: visible;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    0 8rpx 28rpx rgba(0, 0, 0, 0.04);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.9);
}

/* ================================================================
   Header bar
   ================================================================ */

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.app-header .wordmark {
  display: block;
  font-family: "SF Pro Display", "Inter", -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #1d1d1f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.015em;
}

.app-header .greeting {
  display: block;
  margin-top: 4rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 400;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 80ms ease-out;
}

.logout-button:active {
  transform: scale(0.95);
}

/* ================================================================
   Segmented control — sync with auth: 68rpx + 5rpx padding + border
   ================================================================ */

.tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  margin-bottom: 28rpx;
  padding: 5rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 24rpx;
  background: #e5e5ea;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tab-pill {
  position: absolute;
  top: 5rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.08),
    0 3rpx 10rpx rgba(0, 0, 0, 0.10);
  z-index: 0;
  pointer-events: none;
  will-change: transform;
}

.tab {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 20rpx;
  background: transparent;
  overflow: hidden;
}

.tab-label {
  display: block;
  max-width: 100%;
  color: #888888;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 6rpx;
  transition: color 0.2s ease;
}

.tab.active .tab-label {
  color: #1d1d1f;
  font-weight: 600;
}

.tab:active {
  transform: scale(0.97);
  transition: transform 80ms ease-out;
}

/* ================================================================
   Todo list
   ================================================================ */

.todo-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 6rpx 20rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}

.todo-item:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06), 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.todo-item.done {
  opacity: 0.45;
}

.todo-item.deleting {
  opacity: 0;
  transition: opacity 0.22s ease;
}

/* ---- Check circle ---- */

.check-button {
  position: relative;
  z-index: 1;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border: 2.5rpx solid #d1d1d6;
  border-radius: 50%;
  background: transparent;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.todo-item.done .check-button {
  border-color: #1d1d1f;
  background: #1d1d1f;
}

/* ---- Content ---- */

.todo-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.todo-title {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.42;
  word-break: break-word;
}

.todo-item.done .todo-title {
  text-decoration: line-through;
  color: #888888;
}

.todo-meta {
  display: block;
  margin-top: 6rpx;
  color: #888888;
  font-size: 23rpx;
  font-weight: 500;
}

/* ---- Action buttons ---- */

.todo-actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 10rpx;
  flex: 0 0 auto;
}

.action-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f5f5f7;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 600;
}

.action-button:active {
  transform: scale(0.92);
  transition: transform 80ms ease-out;
  background: #e5e5ea;
}

.action-button.danger {
  background: rgba(255, 59, 48, 0.08);
  color: #ff3b30;
}

.action-button.danger:active {
  background: rgba(255, 59, 48, 0.16);
}

/* ---- Action icons ---- */

.action-icon {
  display: block;
  line-height: 1;
}

/* Edit — diagonal pencil stroke */
.action-icon--edit {
  width: 24rpx;
  height: 2.5rpx;
  background: #6e6e73;
  border-radius: 1.5rpx;
  transform: rotate(-45deg);
}

/* Delete — crossed lines forming an X */
.action-icon--delete {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}
.action-icon--delete::before,
.action-icon--delete::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 2.5rpx;
  background: #ff3b30;
  border-radius: 1.5rpx;
}
.action-icon--delete::before {
  transform: translate(-50%, -50%) rotate(45deg);
}
.action-icon--delete::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ================================================================
   Empty & error states
   ================================================================ */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  padding-bottom: 120rpx;
  text-align: center;
}

.empty-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #d1d1d6;
}

.empty-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  color: #6e6e73;
  font-size: 27rpx;
  line-height: 1.5;
  max-width: 440rpx;
  margin-top: 10rpx;
}

.retry-button {
  margin-top: 36rpx;
  max-width: 320rpx;
}

/* ================================================================
   Voice result overlay (parsing / done / error)
   ================================================================ */

.voice-result-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-width: 360rpx;
  max-width: 520rpx;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    0 8rpx 32rpx rgba(0, 0, 0, 0.12),
    0 24rpx 64rpx rgba(0, 0, 0, 0.16);
}

.result-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 700;
}

.result-card.done .result-icon {
  background: rgba(52, 199, 89, 0.12);
  color: #34c759;
}

.result-card.error .result-icon {
  background: rgba(255, 59, 48, 0.12);
  color: #ff3b30;
}

.result-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: #1d1d1f;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.result-message {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
}

.result-transcript {
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.005em;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================================================================
   Voice button
   ================================================================ */

.voice-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + constant(safe-area-inset-bottom));
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 6;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #1c1c1c 0%, #000000 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.05em;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 4rpx 16rpx rgba(0, 0, 0, 0.14),
    0 12rpx 32rpx rgba(0, 0, 0, 0.10);
}

.voice-button.recording {
  background: #ff3b30;
  color: #ffffff;
  box-shadow:
    0 4rpx 16rpx rgba(255, 59, 48, 0.25),
    0 12rpx 36rpx rgba(255, 59, 48, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.voice-button.recording::after {
  content: '';
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  left: -6rpx;
  border-radius: 34rpx;
  border: 3rpx solid rgba(255, 59, 48, 0.3);
  animation: voicePulse 1.2s ease-out infinite;
  pointer-events: none;
}

.voice-button.recording::before {
  content: '';
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  left: -12rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 59, 48, 0.12);
  animation: voicePulse 1.2s ease-out 0.4s infinite;
  pointer-events: none;
}

.voice-button.cancel {
  background: #8e8e93;
  color: #ffffff;
}

.voice-button.cancel::after {
  border-color: rgba(142, 142, 147, 0.25);
}

.voice-button.cancel::before {
  border-color: rgba(142, 142, 147, 0.10);
}

@keyframes voicePulse {
  0%   { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.08); opacity: 0; }
}

/* ================================================================
   Edit bottom sheet
   ================================================================ */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.edit-sheet {
  width: 100%;
  padding: 0 32rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  box-sizing: border-box;
  box-shadow:
    0 -6rpx 24rpx rgba(0, 0, 0, 0.08),
    0 -24rpx 56rpx rgba(0, 0, 0, 0.14);
  border-top: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ---- Drag handle ---- */

.sheet-handle-area {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 16rpx;
}

.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #c7c7cc;
}

/* ---- Sheet header ---- */

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-family: "SF Pro Display", "Inter", -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f7;
}

.sheet-close:active {
  background: #e5e5ea;
  transform: scale(0.9);
  transition: transform 80ms ease-out;
}

.sheet-close-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}
.sheet-close-icon::before,
.sheet-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 2.5rpx;
  background: #6e6e73;
  border-radius: 1.5rpx;
}
.sheet-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}
.sheet-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ---- Edit form ---- */

.edit-field {
  margin-bottom: 14rpx;
  border: none;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 6rpx 20rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.2s ease;
}

.edit-field:focus {
  border-color: transparent;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
    inset 3rpx 0 0 #1d1d1f,
    0 2rpx 12rpx rgba(0, 0, 0, 0.06),
    0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.edit-placeholder {
  color: #8e8e93;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.005em;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.edit-label {
  color: #6e6e73;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.005em;
}

.picker-value,
.time-picker {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.005em;
}

.time-picker {
  margin-top: 16rpx;
  padding: 24rpx 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  text-align: right;
}

.save-button {
  margin-top: 36rpx;
}

/* ================================================================
   Reduced motion
   ================================================================ */

page.reduced-motion .edit-sheet {
  transition: opacity 200ms ease;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

page.reduced-motion .voice-button.recording::after,
page.reduced-motion .voice-button.recording::before,
page.reduced-motion .voice-button.cancel::after,
page.reduced-motion .voice-button.cancel::before {
  animation: none;
  opacity: 0;
}
