/*
 * Todos — Main list & interactions
 * Stitch rebuild: flat page, underline tabs, pill task cards.
 * Icons are local Material Symbols SVG assets (see .header-icon & co).
 */

/* ================================================================
   Page
   ================================================================ */

page {
  background: #f9f9f9;
}

.todos-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 0 calc(160rpx + constant(safe-area-inset-bottom));
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f9f9f9;
  color: #1a1c1c;
  overflow: hidden;
}

.todos-page--composer-tall {
  padding-bottom: calc(280rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* ================================================================
   Header bar — custom nav, flat on page background
   ================================================================ */

.app-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  height: 64rpx;
  padding-left: 40rpx;
  padding-bottom: 16rpx;
  box-sizing: content-box;
  background: #f9f9f9;
}

.app-header .wordmark {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.header-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.header-button::after {
  display: none;
}

.header-button:active {
  transform: scale(0.92);
  opacity: 0.65;
}

.settings-button {
  width: 64rpx;
}

.app-header .header-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 4rpx;
}

/* ================================================================
   Content shell
   ================================================================ */

.todos-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  padding: 16rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.tab-section {
  position: relative;
}

/* ================================================================
   Tabs — underline style
   ================================================================ */

.tab-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 80rpx;
}

.tabs {
  position: relative;
  display: flex;
  align-items: center;
  flex: 0 1 auto;
  gap: 28rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.tab::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  border: 0;
  border-radius: 2rpx;
  background: transparent;
}

.tab.active::after {
  background: #000000;
}

.tab-label {
  display: block;
  max-width: none;
  padding: 0;
  color: #5d5e63;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 44rpx;
  overflow: visible;
  transition: color 0.2s ease;
}

.tab.active .tab-label {
  color: #000000;
  font-weight: 700;
}

.tab:active {
  transform: scale(0.97);
  transition: transform 80ms ease-out;
}

/* ---- Header tools: AI organize + completed visibility ---- */

.list-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
  gap: 8rpx;
}

.organize-button,
.visibility-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 9999rpx;
  background: transparent;
  box-shadow: none;
  color: #5d5e63;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.organize-button::after,
.visibility-button::after {
  display: none;
}

.organize-button[disabled] {
  opacity: 0.35;
}

.organize-button--active {
  color: #000000;
}

.sparkle-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin-right: 6rpx;
  color: currentColor;
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.72;
}

.visibility-button {
  width: 64rpx;
  min-width: 64rpx;
  padding: 0;
}

.organize-button:active,
.visibility-button:active {
  transform: scale(0.92);
  opacity: 0.65;
}

/* ---- AI organize: group title row ---- */

.organize-group-title {
  padding: 12rpx 16rpx 0;
  color: #5d5e63;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.organize-group-title:first-child {
  padding-top: 2rpx;
}

/* ---- AI organize: loading row ---- */

.organize-loading {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 24rpx 36rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.organize-loading-icon {
  display: block;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  animation: organize-spin 0.8s linear infinite;
}

.organize-loading-title {
  color: #000000;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}

@keyframes organize-spin {
  to { transform: rotate(360deg); }
}

/* ================================================================
   Todo list
   ================================================================ */

/* 独立滚动容器：顶栏 + tab 固定，列表区域滚动 */
.todo-scroll {
  flex: 1;
  min-height: 0;
  height: 0; /* flex 子项滚动容器需显式高度基准 */
  width: 100%;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

/* ---- Swipe wrapper ---- */

.todo-swipe-wrapper {
  position: relative;
  border-radius: 64rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.todo-swipe-wrapper:active {
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.todo-swipe-wrapper.delete-pending {
  opacity: 0.55;
  pointer-events: none;
}

.todo-swipe-wrapper.deleting {
  opacity: 0;
  transition: opacity 0.22s ease;
}

/* ---- Swipe action rail (revealed by one swipe; taps run actions) ---- */

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
  overflow: hidden;
  border-radius: inherit;
}

.swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.swipe-action::after {
  display: none;
}

.swipe-action--tomorrow {
  background: #e3e2e7;
}

.swipe-action--pin {
  background: #e2e2e7;
}

.swipe-action--delete {
  background: #ffdad6;
}

.swipe-action:active {
  opacity: 0.65;
}

.swipe-action-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.76;
}

.swipe-action--delete .swipe-action-icon {
  opacity: 1;
}

/* ---- Todo item ---- */

.todo-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 24rpx 36rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-sizing: border-box;
  will-change: transform;
}

/* Pinned: bold black capsule border, plain white surface */
.todo-item.pinned {
  border: 4rpx solid #1d1d1f;
  background: #ffffff;
}

.todo-item.done .todo-title {
  text-decoration: line-through;
  color: #b3b3b9;
}

.todo-item.done .todo-meta {
  color: #c7c7cc;
}

/* ---- Check circle ---- */

.check-button {
  position: relative;
  z-index: 1;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #7e7576;
  border-radius: 50%;
  background: transparent;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.todo-item.done .check-button {
  border-color: #1d1d1f;
  background: #1d1d1f;
}

/* Done: right-side actions dim but stay tappable */
.todo-item.done .todo-action-icon {
  opacity: 0.35;
}

/* ---- Content ---- */

.todo-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.todo-title {
  display: block;
  color: #000000;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 40rpx;
  word-break: break-word;
}

.todo-meta {
  display: block;
  margin-top: 4rpx;
  color: #5d5e63;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

/* ---- Always-visible action buttons ---- */

.edit-btn,
.remind-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  padding: 0;
  margin: 0;
  flex: 0 0 auto;
}

.edit-btn::after,
.remind-btn::after {
  border: none;
}

.edit-btn:active,
.remind-btn:active {
  background: #f0f0f2;
}

.remind-btn {
  color: #5d5e63;
}

.remind-btn--on {
  color: #000000;
}

/* ================================================================
   Loading, empty and network states
   ================================================================ */

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 24rpx 36rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.skeleton-check {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.skeleton-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-line,
.skeleton-shimmer {
  background: linear-gradient(90deg, #e8e8e8 0%, #f3f3f4 48%, #e8e8e8 100%);
  background-size: 220% 100%;
  animation: state-shimmer 1.6s ease-in-out infinite;
}

.skeleton-line--title {
  height: 26rpx;
  border-radius: 9999rpx;
}

.skeleton-line--meta {
  height: 18rpx;
  border-radius: 9999rpx;
}

.skeleton-line--title-0 { width: 74%; }
.skeleton-line--title-1 { width: 58%; }
.skeleton-line--title-2 { width: 82%; }
.skeleton-line--title-3 { width: 66%; }
.skeleton-line--meta-0 { width: 40%; }
.skeleton-line--meta-1 { width: 32%; }
.skeleton-line--meta-2 { width: 46%; }
.skeleton-line--meta-3 { width: 36%; }

.skeleton-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.skeleton-action {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

@keyframes state-shimmer {
  0% { background-position: 120% 0; }
  100% { background-position: -120% 0; }
}

.state-view {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 60vh;
  padding: 32rpx 40rpx 128rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-state-minimal {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding-bottom: 128rpx;
  box-sizing: border-box;
}

.empty-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 9999rpx;
  background: #dadada;
}

.state-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.state-icon-shell--error {
  background: #ffdad6;
}

.state-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  opacity: 0.76;
}

.state-icon-shell--error .state-icon {
  opacity: 1;
}

.state-title {
  margin-top: 24rpx;
  color: #000000;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.state-primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 240rpx;
  height: 96rpx;
  margin: 32rpx 0 0;
  padding: 0;
  border-radius: 9999rpx;
  background: #000000;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.state-primary-action::after {
  display: none;
}

.state-primary-action:active {
  transform: scale(0.96);
  opacity: 0.82;
}

.state-action-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

/* ================================================================
   Microphone permission modal
   ================================================================ */

.permission-mask {
  position: fixed;
  inset: 0;
  z-index: 1400;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.permission-card {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 670rpx;
  padding: 56rpx 48rpx 40rpx;
  border-radius: 64rpx;
  background: #f9f9f9;
  box-sizing: border-box;
  flex-direction: column;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
  text-align: center;
}

.permission-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.permission-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  opacity: 0.76;
}

.permission-title {
  margin-top: 24rpx;
  color: #000000;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.permission-primary,
.permission-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  border-radius: 9999rpx;
  font-weight: 600;
}

.permission-primary::after,
.permission-secondary::after {
  display: none;
}

.permission-primary {
  height: 104rpx;
  margin-top: 32rpx;
  background: #000000;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 104rpx;
}

.permission-secondary {
  height: 88rpx;
  margin-top: 12rpx;
  background: transparent;
  color: #5d5e63;
  font-size: 28rpx;
  line-height: 88rpx;
}

.permission-primary:active,
.permission-secondary:active {
  transform: scale(0.96);
  opacity: 0.7;
}

/* ================================================================
   Composer — light-gray shell dock, black voice action
   ================================================================ */

.input-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 6;
  padding: 0 40rpx;
  pointer-events: none;
}

.input-dock--expanded {
  top: 0;
  z-index: 8;
  padding: 0;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.2);
}

.composer-surface {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 9999rpx;
  background: rgba(226, 226, 226, 0.94);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  pointer-events: auto;
}

.composer-surface--expanded {
  position: absolute;
  left: 0;
  right: 0;
  min-height: 100rpx;
  align-items: stretch;
  padding: 0 0 constant(safe-area-inset-bottom);
  padding: 0 0 env(safe-area-inset-bottom);
  border: 0;
  border-radius: 64rpx 64rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.input-dock--keyboard-visible .composer-surface--expanded {
  padding-bottom: 0;
}

.composer-editor {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 32rpx;
  border-radius: 9999rpx;
  background: #f3f3f4;
  box-sizing: border-box;
}

.composer-surface--expanded .composer-editor {
  min-height: 0;
  align-items: stretch;
  margin: 0;
  padding: 40rpx 40rpx 32rpx;
  border-radius: 64rpx 64rpx 0 0;
  background: #ffffff;
}

.composer-editor--voice {
  justify-content: center;
  background: #000000;
}

.composer-textarea {
  flex: 1;
  width: 100%;
  min-height: 45rpx;
  max-height: 180rpx;
  padding: 0;
  box-sizing: border-box;
  color: #000000;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 48rpx;
  letter-spacing: 0.005em;
}

.composer-textarea--overflow {
  height: 180rpx;
  overflow-y: auto;
}

.composer-textarea--expanded {
  height: 100%;
  min-height: 0;
  max-height: none;
  overflow-y: auto;
  padding-right: 84rpx;
  padding-bottom: 112rpx;
  color: #000000;
  font-size: 34rpx;
  line-height: 1.65;
}

.composer-placeholder {
  color: rgba(76, 69, 70, 0.5);
  font-size: 34rpx;
  font-weight: 400;
}

.composer-hold-text {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.005em;
  user-select: none;
  -webkit-user-select: none;
}

.composer-surface--recording .composer-hold-text {
  color: #ffffff;
}

/* A compact capsule in both layouts; no full-height control rail. */
.composer-action-group {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-end;
  align-self: center;
  height: 96rpx;
  margin: 0;
  border: 0;
  border-radius: 9999rpx;
  background: transparent;
  box-sizing: border-box;
  overflow: hidden;
}

.composer-surface--expanded .composer-action-group {
  position: absolute;
  right: 20rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 90rpx;
  margin: 0;
  align-self: auto;
  z-index: 2;
  border-radius: 20rpx;
  background: #eeeeee;
}

.input-dock--keyboard-visible .composer-surface--expanded .composer-action-group {
  bottom: 20rpx;
}

.composer-action {
  flex: 0 0 auto;
  width: 88rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000000;
  box-sizing: border-box;
}

.composer-action + .composer-action {
  border-left: 0;
}

.composer-action--send,
.composer-action--toggle,
.composer-action:active {
  background: transparent;
  color: #000000;
}

.composer-action--disabled {
  opacity: 0.4;
}

/* Expand/fold uses the same surface, border, radius and stroke language. */
.composer-corner-control {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 18rpx;
  color: #000000;
  background: #eeeeee;
  box-sizing: border-box;
}

.composer-corner-control--expanded {
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}

.composer-corner-control:active {
  background: rgba(255, 255, 255, 0.14);
}

/* ================================================================
   Edit bottom sheet
   ================================================================ */

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.edit-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 92vh;
  max-height: 92vh;
  overflow: hidden;
  padding: 0 40rpx;
  border-radius: 96rpx 96rpx 0 0;
  background: #f9f9f9;
  box-sizing: border-box;
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.12);
}

.sheet-handle-area {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 24rpx;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #dadada;
}

.sheet-head {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
}

.sheet-scroll-content {
  padding: 16rpx 0 24rpx;
}

.sheet-footer {
  flex: 0 0 auto;
  padding: 24rpx 0 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-head-copy,
.setting-copy,
.remind-summary-copy,
.remind-custom-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.sheet-title {
  color: #000000;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.sheet-subtitle {
  margin-top: 8rpx;
  color: #5d5e63;
  font-size: 26rpx;
  line-height: 36rpx;
}

.sheet-close {
  display: flex;
  align-items: center;
  flex: 0 0 64rpx;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #eeeeee;
}

.sheet-close::after,
.remind-cancel::after {
  display: none;
}

.sheet-close:active {
  transform: scale(0.96);
  opacity: 0.7;
  transition: transform 80ms ease-out;
}

.sheet-section + .sheet-section {
  margin-top: 40rpx;
}

.sheet-section-label {
  display: block;
  margin: 0 16rpx 16rpx;
  color: #5d5e63;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  letter-spacing: 0.04em;
}

.edit-task-field {
  width: 100%;
  height: 112rpx;
  padding: 0 40rpx;
  border: 1rpx solid transparent;
  border-radius: 64rpx;
  background: #f3f3f4;
  box-sizing: border-box;
  color: #000000;
  font-size: 34rpx;
  line-height: 44rpx;
}

.edit-task-field:focus {
  background: #eeeeee;
}

.edit-placeholder {
  color: rgba(76, 69, 70, 0.5);
  font-size: 34rpx;
}

.schedule-card,
.remind-options {
  overflow: hidden;
  border-radius: 64rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.setting-picker {
  display: block;
}

.sheet-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}

.sheet-setting-row:active,
.remind-option:active,
.remind-custom-field:active {
  opacity: 0.65;
}

.sheet-setting-row--time {
  min-height: 96rpx;
  padding-left: 104rpx;
}

.setting-leading,
.setting-value-wrap,
.remind-option-end,
.remind-summary {
  display: flex;
  align-items: center;
}

.setting-leading {
  min-width: 0;
  flex: 1;
  gap: 24rpx;
}

.setting-icon-wrap,
.remind-summary-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.setting-icon,
.remind-summary-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.72;
}

.setting-title,
.setting-caption {
  display: block;
}

.setting-title {
  color: #1a1c1c;
  font-size: 30rpx;
  line-height: 40rpx;
}

.setting-caption {
  margin-top: 2rpx;
  color: #5d5e63;
  font-size: 24rpx;
  line-height: 32rpx;
}

.setting-value-wrap {
  flex: 0 0 auto;
  gap: 4rpx;
  margin-left: 16rpx;
}

.setting-value {
  color: #5d5e63;
  font-size: 26rpx;
  line-height: 36rpx;
}

.setting-value--strong {
  color: #000000;
  font-size: 30rpx;
}

.setting-chevron {
  display: block;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.42;
}

.sheet-divider {
  height: 1rpx;
  margin-left: 104rpx;
  background: #e2e2e2;
}

.sheet-divider--indented {
  margin-left: 104rpx;
}

.sheet-switch {
  position: relative;
  flex: 0 0 auto;
  width: 88rpx;
  height: 52rpx;
  border-radius: 9999rpx;
  background: #e2e2e2;
  transition: background 160ms ease;
}

.sheet-switch-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.14);
  transition: transform 160ms ease;
}

.sheet-switch--on {
  background: #000000;
}

.sheet-switch--on .sheet-switch-thumb {
  transform: translateX(36rpx);
}

.save-button {
  height: 112rpx;
  margin-top: 0;
  border-radius: 64rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 112rpx;
}

.remind-summary {
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 64rpx;
  background: #eeeeee;
}

.remind-summary-copy {
  flex: 1;
}

.remind-summary-title,
.remind-summary-meta {
  display: block;
}

.remind-summary-title {
  overflow: hidden;
  color: #1a1c1c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remind-summary-meta {
  margin-top: 4rpx;
  color: #5d5e63;
  font-size: 24rpx;
  line-height: 32rpx;
}

.remind-section-label {
  margin-top: 40rpx;
}

.remind-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 12rpx 32rpx;
  box-sizing: border-box;
  color: #1a1c1c;
}

.remind-option + .remind-option {
  border-top: 1rpx solid #e2e2e2;
}

.remind-option-label {
  font-size: 28rpx;
  line-height: 38rpx;
}

.remind-option--active {
  color: #000000;
  font-weight: 600;
}

.remind-option--disabled {
  opacity: 0.3;
}

.remind-option-end {
  flex: 0 0 auto;
  gap: 20rpx;
  margin-left: 16rpx;
}

.remind-option-time {
  font-size: 24rpx;
  color: #5d5e63;
  line-height: 32rpx;
}

.remind-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #7e7576;
  border-radius: 50%;
  box-sizing: border-box;
}

.remind-radio--active {
  border-color: #000000;
  background: #000000;
}

.remind-radio-check {
  display: block;
  width: 26rpx;
  height: 26rpx;
}

.remind-custom {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.remind-custom-picker {
  min-width: 0;
  flex: 1;
}

.remind-custom-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 16rpx 20rpx;
  border-radius: 40rpx;
  background: #eeeeee;
  box-sizing: border-box;
}

.remind-custom-icon {
  display: block;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.68;
}

.remind-custom-label {
  color: #5d5e63;
  font-size: 22rpx;
  line-height: 30rpx;
}

.remind-custom-value {
  color: #000000;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.remind-cancel {
  width: 100%;
  height: 88rpx;
  margin: 0 0 16rpx;
  padding: 0;
  border-radius: 44rpx;
  background: #ffdad6;
  color: #93000a;
  font-size: 26rpx;
  line-height: 88rpx;
}

.remind-cancel:active {
  transform: scale(0.96);
  opacity: 0.7;
}

/* ================================================================
   Calendar — in-flow expansion under the tabs (does not overlay)
   ================================================================ */

.calendar-wrap {
  position: relative;
  top: auto;
  left: auto;
  right: auto;
  z-index: 1;
  width: 100%;
  margin-top: 24rpx;
  border-radius: 0;
  box-shadow: none;
}

.calendar {
  padding: 12rpx 0 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 10rpx;
}

.cal-title {
  color: #000000;
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 80ms ease-out;
}

.cal-nav:active {
  background: #f0f0f2;
  transform: scale(0.9);
}

.cal-weekdays {
  display: flex;
  padding: 0 4rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 2.2;
}

.cal-grid {
  display: flex;
  flex-direction: column;
}

.cal-week {
  display: flex;
}

.cal-day {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 18rpx;
  transition: transform 80ms ease-out;
}

.cal-day:active {
  transform: scale(0.92);
}

.cal-day-num {
  display: block;
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.cal-day--dim .cal-day-num {
  color: transparent;
}

.cal-day--dim:active,
.cal-day--past:active {
  transform: none;
}

.cal-day--past .cal-day-num {
  color: #c7c7cc;
  font-weight: 400;
}

.cal-day--selected .cal-day-num {
  background: #000000;
  color: #ffffff;
  font-weight: 700;
}

.cal-dot {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #000000;
}

/* ================================================================
   Local Material Symbols assets — sizing only
   ================================================================ */

.header-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.visibility-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border: 0;
  border-radius: 0;
}

.cal-arrow {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border: 0;
  transform: none;
}

.check-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
}

.todo-action-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.65;
}

.remind-btn--on .todo-action-icon {
  opacity: 1;
}

.composer-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.resize-icon,
.sheet-close-icon {
  display: block;
  position: static;
  width: 32rpx;
  height: 32rpx;
}

/* ================================================================
   Reduced motion
   ================================================================ */

page.reduced-motion .skeleton-line,
page.reduced-motion .skeleton-shimmer {
  animation: none;
}

page.reduced-motion .organize-loading-icon {
  animation: none;
}

page.reduced-motion .edit-sheet {
  transition: opacity 200ms ease;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

page.reduced-motion .composer-surface {
  transition: none;
}
