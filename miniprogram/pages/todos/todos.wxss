/*
 * Todos — Main list & interactions
 * Apple Design · Balanced proportions · Consistent with auth
 */

/* ================================================================
   Page
   ================================================================ */

.todos-page {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  /* Composer bar: 24rpx bottom + 100rpx height + breathing room */
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.todos-page--composer-tall {
  padding-bottom: calc(280rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* ================================================================
   Section cards — three-section layout
   Material weight encodes hierarchy (§12):
     Header (small) → lightest lift
     Body   (large) → thicker surface, deeper shadow
     Composer (bottom input) → same white surface, anchors the page
   ================================================================ */

.section-card {
  border-radius: 28rpx;
  background: #ffffff;
}

/* Header — smallest surface, lightest elevation */
.section-header {
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.8);
}

/* Body — main content, thicker surface, deeper shadow */
.section-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 20rpx;
  overflow: visible;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    0 8rpx 28rpx rgba(0, 0, 0, 0.04);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.9);
}

/* ================================================================
   Header bar
   ================================================================ */

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.app-header .wordmark {
  display: block;
  font-family: "SF Pro Display", "Inter", -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #1d1d1f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.015em;
}

/* Completed-items visibility toggle — header capsule button */
.visibility-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 80ms ease-out;
}

.visibility-button:active {
  transform: scale(0.95);
}

/* Header actions: trash entry + visibility toggle */
.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trash-button,
.settings-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 80ms ease-out;
}

.trash-button:active,
.settings-button:active {
  transform: scale(0.95);
}

.settings-icon {
  color: #6e6e73;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.settings-button {
  width: 76rpx;
}

.trash-icon {
  position: relative;
  width: 30rpx;
  height: 34rpx;
}

.trash-lid {
  position: absolute;
  top: 2rpx;
  left: 5rpx;
  width: 20rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: #6e6e73;
}

.trash-bin {
  position: absolute;
  left: 3rpx;
  bottom: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #6e6e73;
}

.trash-bin::after {
  content: "";
  position: absolute;
  top: 9rpx;
  left: 5rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #ffffff;
}

/* ================================================================
   Segmented control — sync with auth: 68rpx + 5rpx padding + border
   ================================================================ */

.tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  margin-bottom: 28rpx;
  padding: 5rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 24rpx;
  background: #e5e5ea;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tab-pill {
  position: absolute;
  top: 5rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.08),
    0 3rpx 10rpx rgba(0, 0, 0, 0.10);
  z-index: 0;
  pointer-events: none;
  will-change: transform;
}

.tab {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 20rpx;
  background: transparent;
  overflow: hidden;
}

.tab-label {
  display: block;
  max-width: 100%;
  color: #888888;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 6rpx;
  transition: color 0.2s ease;
}

.tab.active .tab-label {
  color: #1d1d1f;
  font-weight: 600;
}

.tab:active {
  transform: scale(0.97);
  transition: transform 80ms ease-out;
}

/* ================================================================
   AI organize switch (today view) — compact segmented control
   ================================================================ */

.organize-switch {
  display: inline-flex;
  align-self: flex-start;
  padding: 4rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 20rpx;
  background: #e5e5ea;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.organize-seg {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  color: #888888;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  transition: color 0.2s ease, background 0.2s ease;
}

.organize-seg--active {
  background: #ffffff;
  color: #1d1d1f;
  font-weight: 600;
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.08),
    0 3rpx 10rpx rgba(0, 0, 0, 0.10);
}

.organize-seg:active {
  transform: scale(0.96);
  transition: transform 80ms ease-out;
}

/* ---- AI organize: group title row ---- */

.organize-group-title {
  padding: 14rpx 8rpx 2rpx;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.organize-group-title:first-child {
  padding-top: 2rpx;
}

/* ---- AI organize: loading row ---- */

.organize-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.organize-loading-text {
  color: #6e6e73;
  font-size: 26rpx;
}

/* ================================================================
   Todo list
   ================================================================ */

.todo-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ---- Swipe wrapper ---- */

.todo-swipe-wrapper {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 6rpx 20rpx rgba(0, 0, 0, 0.03);
}

.todo-swipe-wrapper:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06), 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

/* ---- Swipe zones (behind the sliding card) ---- */

.swipe-zone {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
  width: 160rpx;
}

.swipe-zone--pin {
  left: 0;
  border-top-left-radius: 24rpx;
  border-bottom-left-radius: 24rpx;
  background: #f5f5f7;
}

.swipe-zone--delete {
  right: 0;
  border-top-right-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  background: rgba(255, 59, 48, 0.10);
}

/* ---- Swipe icons (CSS line-art, auth-page style) ---- */

.swipe-icon-img {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

/* 置顶：图钉（描边帽 + 针） */
.swipe-icon--pin::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 2.5rpx solid #8e8e93;
  border-radius: 7rpx 7rpx 4rpx 4rpx;
  box-sizing: border-box;
}
.swipe-icon--pin::after {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2.5rpx;
  height: 17rpx;
  border-radius: 1.5rpx;
  background: #8e8e93;
}

/* 删除：垃圾桶（描边桶身 + 盖线） */
.swipe-icon--trash::before {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 20rpx;
  border: 2.5rpx solid #8e8e93;
  border-radius: 3rpx 3rpx 5rpx 5rpx;
  box-sizing: border-box;
}
.swipe-icon--trash::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 2.5rpx;
  border-radius: 1.5rpx;
  background: #8e8e93;
}

/* 编辑：抽象书写符号 —— 右上开口的方框 + 斜线（左下→右上） */
.edit-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}
.edit-frame {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-left: 2.5rpx solid #8e8e93;
  border-bottom: 2.5rpx solid #8e8e93;
  border-radius: 4rpx;
}
.edit-frame::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 72%;
  height: 2.5rpx;
  border-radius: 1.5rpx;
  background: #8e8e93;
}
.edit-frame::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 2.5rpx;
  height: 72%;
  border-radius: 1.5rpx;
  background: #8e8e93;
}
.edit-stroke {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 22rpx;
  height: 2.5rpx;
  border-radius: 1.5rpx;
  background: #8e8e93;
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ---- Edit button (always visible on card) ---- */

.edit-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  flex: 0 0 auto;
}
.edit-btn::after { border: none; }
.edit-btn:active { background: #f0f0f2; }

/* ---- Move-to-tomorrow button (always visible on pending cards) ---- */

.tomorrow-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  flex: 0 0 auto;
}
.tomorrow-btn::after { border: none; }
.tomorrow-btn:active { background: #f0f0f2; }

/* 移到明天：向右箭头（把待办推到明天） */
.tomorrow-icon {
  position: relative;
  width: 26rpx;
  height: 22rpx;
}
.tomorrow-icon::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 15rpx;
  height: 2.5rpx;
  border-radius: 1.5rpx;
  background: #8e8e93;
  transform: translateY(-50%);
}
.tomorrow-icon::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  border-top: 2.5rpx solid #8e8e93;
  border-right: 2.5rpx solid #8e8e93;
  transform: translateY(-50%) rotate(45deg);
}

/* ---- Reminder button (bell; on = accent) ---- */

.remind-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  flex: 0 0 auto;
  color: #8e8e93;
}
.remind-btn::after { border: none; }
.remind-btn:active { background: #f0f0f2; }
.remind-btn--on { color: #ff9f0a; }

/* 铃铛：拱形钟体 + 底部钟锤 */
.remind-icon {
  position: relative;
  width: 24rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  box-sizing: border-box;
}
.remind-icon::before {
  content: '';
  position: absolute;
  left: -5rpx;
  right: -5rpx;
  bottom: 0;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.remind-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -9rpx;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 卡片内提醒行（内容下方） */
.todo-reminder {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #ff9f0a;
}

/* ---- Todo item (slides to reveal zones) ---- */

.todo-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  will-change: transform;
}

.todo-item.done .todo-content {
  opacity: 0.5;
}

.todo-item.pinned {
  background: #fffaf3;
}
.todo-item.pinned::before {
  content: '';
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 3rpx 3rpx 0;
  background: #ff9f0a;
}

.todo-swipe-wrapper.deleting {
  opacity: 0;
  transition: opacity 0.22s ease;
}

/* ---- Check circle ---- */

.check-button {
  position: relative;
  z-index: 1;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border: 2.5rpx solid #d1d1d6;
  border-radius: 50%;
  background: transparent;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.todo-item.done .check-button {
  border-color: #1d1d1f;
  background: #1d1d1f;
}

/* ---- Content ---- */

.todo-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.todo-title {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.42;
  word-break: break-word;
}

.todo-item.done .todo-title {
  text-decoration: line-through;
  color: #888888;
}

.todo-meta {
  display: block;
  margin-top: 6rpx;
  color: #888888;
  font-size: 23rpx;
  font-weight: 500;
}

/* ================================================================
   Empty & error states
   ================================================================ */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  padding-bottom: 120rpx;
  text-align: center;
}

.empty-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #d1d1d6;
}

.empty-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  color: #6e6e73;
  font-size: 27rpx;
  line-height: 1.5;
  max-width: 440rpx;
  margin-top: 10rpx;
}

.retry-button {
  margin-top: 36rpx;
  max-width: 320rpx;
}

/* ================================================================
   Composer — shared state, independent compact/expanded geometry
   ================================================================ */

.input-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 6;
  padding: 0 24rpx;
  pointer-events: none;
}

.input-dock--expanded {
  top: 0;
  z-index: 8;
  padding: 0;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.55);
}

.composer-surface {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #1c1c1c 0%, #000000 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 4rpx 20rpx rgba(0, 0, 0, 0.14);
  pointer-events: auto;
}

.composer-surface--expanded {
  position: absolute;
  left: 0;
  right: 0;
  min-height: 100rpx;
  align-items: stretch;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.input-dock--keyboard-visible .composer-surface--expanded {
  padding-bottom: 0;
}

.composer-surface--recording {
  box-shadow:
    0 0 0 3rpx rgba(255, 59, 48, 0.55),
    0 4rpx 20rpx rgba(0, 0, 0, 0.14);
}

.composer-editor {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.composer-surface--expanded .composer-editor {
  min-height: 0;
  align-items: stretch;
  padding: 28rpx 28rpx 24rpx;
}

.composer-editor--voice {
  justify-content: center;
}

.composer-textarea {
  flex: 1;
  width: 100%;
  min-height: 45rpx;
  max-height: 180rpx;
  padding: 0;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 45rpx;
  letter-spacing: 0.005em;
}

.composer-textarea--overflow {
  height: 180rpx;
  overflow-y: auto;
}

.composer-textarea--expanded {
  height: 100%;
  min-height: 0;
  max-height: none;
  overflow-y: auto;
  /* Clear the attached top control and bottom action dock. */
  padding: 0 84rpx 112rpx 0;
}

.composer-placeholder {
  color: rgba(255, 255, 255, 0.45);
  font-size: 30rpx;
  font-weight: 400;
}

.composer-hold-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 0.005em;
  user-select: none;
  -webkit-user-select: none;
}

.composer-surface--recording .composer-hold-text {
  color: #ff453a;
}

/* A compact capsule in both layouts; no full-height control rail. */
.composer-action-group {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-end;
  align-self: flex-end;
  height: 90rpx;
  margin: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  box-sizing: border-box;
  overflow: hidden;
}

.composer-surface--expanded .composer-action-group {
  position: absolute;
  right: 20rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 90rpx;
  margin: 0;
  align-self: auto;
  z-index: 2;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}

.input-dock--keyboard-visible .composer-surface--expanded .composer-action-group {
  bottom: 20rpx;
}

.composer-action {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.composer-action + .composer-action {
  border-left: 1rpx solid rgba(255, 255, 255, 0.16);
}

.composer-action--send {
  background: rgba(255, 255, 255, 0.055);
}

.composer-action--toggle {
  color: rgba(255, 255, 255, 0.76);
}

.composer-action:active,
.composer-corner-control:active {
  background: rgba(255, 255, 255, 0.14);
}

.composer-action--disabled {
  opacity: 0.4;
}

/* Expand/fold uses the same surface, border, radius and stroke language. */
.composer-corner-control {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.composer-corner-control--expanded {
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}

.resize-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}

.resize-icon::before,
.resize-icon::after {
  content: '';
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  border-radius: 2rpx;
  box-sizing: border-box;
}

.resize-icon--expand::before {
  top: 1rpx;
  right: 1rpx;
  border-top: 2.5rpx solid currentColor;
  border-right: 2.5rpx solid currentColor;
}

.resize-icon--expand::after {
  left: 1rpx;
  bottom: 1rpx;
  border-left: 2.5rpx solid currentColor;
  border-bottom: 2.5rpx solid currentColor;
}

.resize-icon--collapse::before {
  top: 2rpx;
  left: 2rpx;
  border-right: 2.5rpx solid currentColor;
  border-bottom: 2.5rpx solid currentColor;
}

.resize-icon--collapse::after {
  right: 2rpx;
  bottom: 2rpx;
  border-top: 2.5rpx solid currentColor;
  border-left: 2.5rpx solid currentColor;
}

.send-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 50%;
  width: 22rpx;
  height: 2.5rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translateY(-50%);
}

.send-icon::after {
  content: '';
  position: absolute;
  right: 2rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 2.5rpx solid currentColor;
  border-right: 2.5rpx solid currentColor;
  border-radius: 2rpx;
  transform: translateY(-50%) rotate(45deg);
}

/* ---- Composer icons (2.5rpx hairline, #8e8e93 — same language as swipe icons) ---- */

.kb-icon {
  position: relative;
  width: 32rpx;
  height: 24rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}
.kb-icon::before,
.kb-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  height: 2.5rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.kb-icon::before { top: 6rpx; }
.kb-icon::after  { top: 12rpx; }

/* Sound-wave glyph — three concentric arcs, Doubao-style voice button */
.wave-icon {
  position: relative;
  width: 34rpx;
  height: 30rpx;
}

.wave-arc {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 2.5rpx solid currentColor;
  border-left: none;
  border-radius: 50%;
  box-sizing: border-box;
}

.wave-arc--1 { width: 32rpx; height: 32rpx; }
.wave-arc--2 { width: 22rpx; height: 22rpx; }
.wave-arc--3 { width: 12rpx; height: 12rpx; }

/* ================================================================
   Edit bottom sheet
   ================================================================ */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.edit-sheet {
  width: 100%;
  padding: 0 32rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  box-sizing: border-box;
  box-shadow:
    0 -6rpx 24rpx rgba(0, 0, 0, 0.08),
    0 -24rpx 56rpx rgba(0, 0, 0, 0.14);
  border-top: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ---- Drag handle ---- */

.sheet-handle-area {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 16rpx;
}

.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #c7c7cc;
}

/* ---- Sheet header ---- */

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-family: "SF Pro Display", "Inter", -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f7;
}

.sheet-close:active {
  background: #e5e5ea;
  transform: scale(0.9);
  transition: transform 80ms ease-out;
}

.sheet-close-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}
.sheet-close-icon::before,
.sheet-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 2.5rpx;
  background: #6e6e73;
  border-radius: 1.5rpx;
}
.sheet-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}
.sheet-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ---- Edit form ---- */

.edit-field {
  margin-bottom: 14rpx;
  border: none;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 6rpx 20rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.2s ease;
}

.edit-field:focus {
  border-color: transparent;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
    inset 3rpx 0 0 #1d1d1f,
    0 2rpx 12rpx rgba(0, 0, 0, 0.06),
    0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.edit-placeholder {
  color: #8e8e93;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.005em;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.edit-label {
  color: #6e6e73;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.005em;
}

.picker-value,
.time-picker {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.005em;
}

.time-picker {
  margin-top: 16rpx;
  padding: 24rpx 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  text-align: right;
}

.save-button {
  margin-top: 36rpx;
}

/* ---- Reminder sheet ---- */

.remind-summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 0 8rpx;
}
.remind-summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}
.remind-summary-meta {
  font-size: 24rpx;
  color: #8e8e93;
}

.remind-options {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}
.remind-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f2;
  font-size: 28rpx;
  color: #1d1d1f;
}
.remind-option:active { background: #fafafa; }
.remind-option--active {
  color: #ff9f0a;
  font-weight: 600;
}
.remind-option--disabled {
  color: #c7c7cc;
}
.remind-option-time {
  font-size: 24rpx;
  color: #8e8e93;
}
.remind-option--active .remind-option-time { color: #ff9f0a; }

.remind-custom {
  margin-top: 8rpx;
}

.remind-cancel {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff453a;
  padding: 16rpx 0;
}

/* ================================================================
   Calendar (expandable on 后续 tab)
   ================================================================ */

.tab-section {
  position: relative;
}

.calendar-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%; /* right under the tabs — overlays the list, doesn't push it */
  z-index: 5;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.10);
}

.calendar {
  padding: 14rpx 12rpx 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 6rpx 20rpx rgba(0, 0, 0, 0.03);
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 10rpx;
}

.cal-title {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 80ms ease-out;
}

.cal-nav:active {
  background: #f0f0f2;
  transform: scale(0.9);
}

.cal-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #6e6e73;
  border-left: 3rpx solid #6e6e73;
  border-radius: 2rpx;
  box-sizing: border-box;
}

.cal-arrow--left { transform: rotate(-45deg); }
.cal-arrow--right { transform: rotate(135deg); }

.cal-weekdays {
  display: flex;
  padding: 0 4rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 2.2;
}

.cal-grid {
  display: flex;
  flex-direction: column;
}

.cal-week {
  display: flex;
}

.cal-day {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 18rpx;
  transition: transform 80ms ease-out;
}

.cal-day:active {
  transform: scale(0.92);
}

.cal-day-num {
  display: block;
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.cal-day--dim .cal-day-num {
  color: transparent;
}

.cal-day--dim:active,
.cal-day--past:active {
  transform: none;
}

.cal-day--past .cal-day-num {
  color: #c7c7cc;
  font-weight: 400;
}

.cal-day--selected .cal-day-num {
  color: #1d1d1f;
  font-weight: 700;
}

.cal-dot {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1d1d1f;
}

/* ================================================================
   Reduced motion
   ================================================================ */

page.reduced-motion .edit-sheet {
  transition: opacity 200ms ease;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

page.reduced-motion .composer-surface {
  transition: none;
}
