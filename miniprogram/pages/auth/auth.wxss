page {
  height: 100%;
  background: #f9f9f9;
}

.auth-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
  color: #1a1c1c;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

/* 启动和失败状态 */
.auth-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.auth-launching {
  gap: 44rpx;
  background: #f9f9f9;
}

.auth-launch-wordmark {
  color: #000000;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 82rpx;
  letter-spacing: -0.02em;
  animation: auth-wordmark-pulse 1.8s ease-in-out infinite;
}

.auth-launch-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.auth-spinner {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.65;
  animation: auth-spin 0.8s linear infinite;
}

.auth-launch-text {
  color: #4c4546;
  font-size: 30rpx;
  line-height: 40rpx;
}

.auth-failed {
  gap: 48rpx;
  background: #f9f9f9;
}

.auth-failed-text {
  color: #5d5e63;
  font-size: 34rpx;
  line-height: 44rpx;
  text-align: center;
}

.auth-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 100rpx;
  padding: 0;
  border-radius: 9999rpx;
  background: #000000;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 100rpx;
  text-align: center;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.auth-retry::after {
  display: none;
}

.auth-retry:active {
  transform: scale(0.96);
  opacity: 0.9;
}

@keyframes auth-spin {
  to { transform: rotate(360deg); }
}

@keyframes auth-wordmark-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
