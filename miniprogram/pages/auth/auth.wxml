<view class="auth-page">
  <!-- Hero -->
  <view class="auth-hero">
    <text class="auth-wordmark">mustdo</text>
  </view>

  <!-- Launching -->
  <view class="auth-launch" wx:if="{{phase === 'launching'}}">
    <view class="auth-spinner"></view>
    <text class="auth-launch-text">正在登录…</text>
  </view>

  <!-- Invite gate -->
  <view class="auth-form" wx:elif="{{phase === 'invite'}}">
    <text class="auth-invite-title">填写邀请码继续使用</text>
    <view class="auth-field">
      <view class="auth-field-icon auth-field-icon--invite"></view>
      <input
        class="auth-input"
        value="{{inviteCode}}"
        placeholder="邀请码"
        placeholder-class="auth-placeholder"
        bindinput="onInviteInput"
      />
    </view>
    <text class="auth-error" wx:if="{{error}}">{{error}}</text>
    <button
      class="auth-submit"
      bindtap="submitInvite"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      确认并进入
    </button>
  </view>

  <!-- Failed -->
  <view class="auth-launch" wx:else>
    <text class="auth-error auth-error--center">{{error}}</text>
    <button class="auth-retry" bindtap="retryLogin">重新登录</button>
  </view>
</view>
