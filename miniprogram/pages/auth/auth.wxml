<view class="auth-page auth-page--{{phase}}">
  <!-- 启动登录 -->
  <view wx:if="{{phase === 'launching'}}" class="auth-state auth-launching">
    <text class="auth-launch-wordmark">mustdo</text>
    <view class="auth-launch-status">
      <image class="auth-spinner" src="/assets/icons/png/progress_activity.png" mode="aspectFit" />
      <text class="auth-launch-text">正在登录…</text>
    </view>
  </view>

  <!-- 登录失败 -->
  <view wx:else class="auth-state auth-failed">
    <text class="auth-failed-text">{{error || '微信登录失败，请重试'}}</text>
    <button class="auth-retry" bindtap="retryLogin">重新登录</button>
  </view>
</view>
