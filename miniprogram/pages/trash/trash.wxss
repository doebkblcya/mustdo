@import "../../styles/sheet.wxss";

page {
  min-height: 100%;
  background: #f9f9f9;
}

.trash-page {
  min-height: 100vh;
  background: #f9f9f9;
  color: #1a1c1c;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.trash-navbar {
  height: 64rpx;
  padding-bottom: 16rpx;
  box-sizing: content-box;
}

.trash-navbar-content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  width: 100%;
  height: 64rpx;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.back-button:active {
  transform: scale(0.92);
  opacity: 0.65;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.trash-wordmark {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 50rpx;
  letter-spacing: -0.02em;
}

.notice-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding: 8rpx 40rpx;
  border-bottom: 1rpx solid #e2e2e2;
  box-sizing: border-box;
  color: #5d5e63;
  font-size: 26rpx;
  line-height: 36rpx;
}

.notice-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.trash-tabs {
  display: flex;
  padding: 32rpx 40rpx 0;
}

.trash-tab {
  position: relative;
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 0;
  background: transparent;
  color: #5d5e63;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: center;
}

.trash-tab::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  border: 0;
  border-radius: 2rpx;
  background: transparent;
}

.trash-tab.active {
  color: #000000;
  font-weight: 600;
}

.trash-tab.active::after {
  background: #000000;
}

.trash-content {
  padding: 32rpx 40rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.trash-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 24rpx 36rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.todo-list--overdue .trash-item {
  align-items: stretch;
  flex-direction: column;
  gap: 20rpx;
}

.trash-item-main {
  min-width: 0;
  flex: 1;
}

.trash-item-title,
.trash-item-meta {
  display: block;
}

.trash-item-title {
  color: #000000;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 40rpx;
  word-break: break-word;
}

.trash-item-title.done {
  color: #5d5e63;
  text-decoration: line-through;
}

.trash-item-meta {
  margin-top: 6rpx;
  color: #5d5e63;
  font-size: 24rpx;
  line-height: 34rpx;
}

.trash-item-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 12rpx;
}

.trash-item-actions--overdue {
  width: 100%;
}

.action-btn,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  background: #eeeeee;
  color: #000000;
  font-size: 24rpx;
  line-height: 64rpx;
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.action-btn::after,
.retry-button::after,
.sheet-close::after,
.save-button::after {
  display: none;
}

.action-btn:active,
.retry-button:active {
  transform: scale(0.94);
  opacity: 0.7;
}

.action-btn--primary {
  flex: 1;
  background: #000000;
  color: #ffffff;
}

.action-btn--restore {
  min-width: 104rpx;
}

.action-btn--icon {
  width: 64rpx;
  min-width: 64rpx;
  padding: 0;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.action-btn--danger {
  color: #ba1a1a;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  min-height: 440rpx;
  color: #5d5e63;
  text-align: center;
}

.empty-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #cfc4c5;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 36rpx;
}

.error-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffdad6;
}

.error-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.retry-button--primary {
  min-width: 144rpx;
  background: #000000;
  color: #ffffff;
}

.trash-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.trash-skeleton-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 24rpx 36rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.trash-skeleton-copy {
  min-width: 0;
  flex: 1;
}

.trash-skeleton-line,
.trash-skeleton-action {
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #eeeeee 25%, #f7f7f7 50%, #eeeeee 75%);
  background-size: 200% 100%;
  animation: trash-skeleton-shimmer 1.25s ease-in-out infinite;
}

.trash-skeleton-line--title {
  width: 62%;
  height: 28rpx;
}

.trash-skeleton-line--meta {
  width: 42%;
  height: 20rpx;
  margin-top: 16rpx;
}

.trash-skeleton-action {
  flex: 0 0 auto;
  width: 92rpx;
  height: 56rpx;
}

@keyframes trash-skeleton-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

/* ---- 弹层进出场 ----
   结构与视觉来自 styles/sheet.wxss；todos 页由 JS 弹簧驱动，
   这里用 CSS 过渡：先以 .sheet-mask--open 之外的状态渲染，再加类触发。 */
.sheet-mask {
  opacity: 0;
  transition: opacity 200ms ease-out;
}

.sheet-mask--open {
  opacity: 1;
}

.edit-sheet {
  transform: translateY(100%);
  transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sheet-mask--open .edit-sheet {
  transform: translateY(0);
}
