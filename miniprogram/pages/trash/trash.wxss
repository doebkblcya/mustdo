/*
 * Trash — 已删除 / 已逾期待办（v2-04）
 * Apple Design · 与 todos 页视觉一致
 */

.trash-page {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
}

.section-card {
  border-radius: 28rpx;
  background: #ffffff;
}

/* 顶部说明卡 */
.section-note {
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.8);
}

.note-text {
  display: block;
  text-align: center;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* 主体卡 */
.section-body {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 20rpx;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    0 8rpx 28rpx rgba(0, 0, 0, 0.04);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.9);
}

/* 两段式切换 */
.trash-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rpx;
  padding: 5rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 24rpx;
  background: #e5e5ea;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.trash-tab {
  height: 68rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #6e6e73;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  line-height: 68rpx;
  transition: background 120ms ease-out, color 120ms ease-out;
}

.trash-tab.active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 列表 */
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trash-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.04),
    0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.9);
}

.trash-item-title {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.trash-item-title.done {
  opacity: 0.5;
  text-decoration: line-through;
}

.trash-item-meta {
  display: block;
  margin-top: 6rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.4;
}

/* 行内操作按钮 */
.trash-item-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  background: #f2f2f7;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  transition: opacity 80ms ease-out;
}

.action-btn:active {
  opacity: 0.7;
}

.action-btn--primary {
  background: #1d1d1f;
  color: #ffffff;
}

.action-btn--check {
  width: 56rpx;
  padding: 0;
}

.action-btn--danger {
  background: #ffe5e5;
  color: #d64545;
}

/* 空 / 错误 / 加载态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 88rpx 0;
}

.empty-line {
  width: 120rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #e5e5ea;
}

.empty-desc {
  color: #8e8e93;
  font-size: 26rpx;
}

/* 编辑 bottom sheet */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.edit-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #6e6e73;
  font-size: 32rpx;
}

.edit-field {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  color: #1d1d1f;
  font-size: 30rpx;
  box-sizing: border-box;
}

.edit-placeholder {
  color: #aeaeb2;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
}

.edit-label {
  color: #6e6e73;
  font-size: 28rpx;
}

.picker-value {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 500;
}

.time-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 500;
}

.save-button {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #1d1d1f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.save-button[disabled] {
  opacity: 0.6;
}
