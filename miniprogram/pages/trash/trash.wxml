<view class="trash-page">
  <view class="trash-navbar" style="padding-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="trash-navbar-content" style="height: {{navHeight}}px; padding-right: {{headerRightOffset}}px;">
      <navigator class="back-button" style="width: {{navHeight}}px; height: {{navHeight}}px;" open-type="navigateBack" aria-label="返回">
        <image class="back-icon" src="/assets/icons/png/arrow_back_ios_new.png" mode="aspectFit" />
      </navigator>
      <text class="trash-wordmark">mustdo</text>
    </view>
  </view>

  <view class="notice-bar">
    <image class="notice-icon" src="/assets/icons/png/info.png" mode="aspectFit" />
    <text>删除与逾期待办保留 7 天</text>
  </view>

  <view class="trash-tabs">
    <button class="trash-tab {{activeTab === 'deleted' ? 'active' : ''}}" data-tab="deleted" bindtap="switchTab">
      已删除 {{deletedCount}}
    </button>
    <button class="trash-tab {{activeTab === 'overdue' ? 'active' : ''}}" data-tab="overdue" bindtap="switchTab">
      已逾期 {{overdueCount}}
    </button>
  </view>

  <view class="trash-content">
    <view wx:if="{{loading}}" class="trash-skeleton-list" aria-label="正在加载">
      <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="trash-skeleton-card">
        <view class="trash-skeleton-copy">
          <view class="trash-skeleton-line trash-skeleton-line--title"></view>
          <view class="trash-skeleton-line trash-skeleton-line--meta"></view>
        </view>
        <view class="trash-skeleton-action"></view>
      </view>
    </view>

    <view wx:elif="{{error}}" class="empty-state empty-state--error">
      <view class="error-icon-shell">
        <image class="error-icon" src="/assets/icons/png/error_red.png" mode="aspectFit" />
      </view>
      <text class="empty-desc">{{error || '加载失败'}}</text>
      <button class="retry-button retry-button--primary" bindtap="loadList">重试</button>
    </view>

    <view wx:elif="{{items.length === 0}}" class="empty-state">
      <view class="empty-line"></view>
      <text class="empty-desc">{{activeTab === 'deleted' ? '暂无已删除事项' : '暂无逾期待办'}}</text>
    </view>

    <view wx:else class="todo-list todo-list--{{activeTab}}">
      <view wx:for="{{items}}" wx:key="key" class="trash-item">
        <view class="trash-item-main">
          <text class="trash-item-title {{item.status === 'done' ? 'done' : ''}}">{{item.content}}</text>
          <text class="trash-item-meta">{{item.meta}}</text>
        </view>

        <view wx:if="{{activeTab === 'deleted'}}" class="trash-item-actions trash-item-actions--restore">
          <button class="action-btn action-btn--restore" data-id="{{item.id}}" bindtap="onRestore">恢复</button>
        </view>

        <view wx:else class="trash-item-actions trash-item-actions--overdue">
          <button class="action-btn action-btn--primary" data-id="{{item.id}}" bindtap="onMoveToday">移到今天</button>
          <button class="action-btn action-btn--icon" data-id="{{item.id}}" bindtap="onEdit" aria-label="编辑">
            <image class="action-icon" src="/assets/icons/png/edit.png" mode="aspectFit" />
          </button>
          <button class="action-btn action-btn--icon" data-id="{{item.id}}" bindtap="onToggleDone" aria-label="完成">
            <image class="action-icon" src="/assets/icons/png/done.png" mode="aspectFit" />
          </button>
          <button class="action-btn action-btn--icon action-btn--danger" data-id="{{item.id}}" bindtap="onDelete" aria-label="删除">
            <image class="action-icon" src="/assets/icons/png/delete_error.png" mode="aspectFit" />
          </button>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{editVisible}}"
    class="sheet-mask {{sheetOpen ? 'sheet-mask--open' : ''}}"
    bindtap="onMaskTap"
  >
    <view class="edit-sheet">
      <view class="sheet-handle-area">
        <view class="sheet-handle"></view>
      </view>

      <view class="sheet-head">
        <text class="sheet-title">编辑待办</text>
        <button class="sheet-close" bindtap="cancelEdit" aria-label="关闭">
          <image class="sheet-close-icon" src="/assets/icons/png/close.png" mode="aspectFit" />
        </button>
      </view>

      <scroll-view class="sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-scroll-content">
          <view class="sheet-section">
            <text class="sheet-section-label">待办内容</text>
            <input
              class="edit-task-field"
              value="{{editContent}}"
              placeholder="输入待办内容"
              placeholder-class="edit-placeholder"
              confirm-type="done"
              cursor-spacing="24"
              bindinput="onEditContentInput"
            />
          </view>

          <view class="sheet-section">
            <text class="sheet-section-label">安排</text>
            <view class="schedule-card">
              <picker mode="date" value="{{editDate}}" start="{{todayDate}}" bindchange="onEditDateChange">
                <view class="sheet-setting-row">
                  <view class="setting-leading">
                    <view class="setting-icon-wrap">
                      <image class="setting-icon" src="/assets/icons/png/calendar_month.png" mode="aspectFit" />
                    </view>
                    <text class="setting-title">日期</text>
                  </view>
                  <view class="setting-value-wrap">
                    <text class="setting-value">{{editDate}}</text>
                    <image class="setting-chevron" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
                  </view>
                </view>
              </picker>

              <view class="sheet-divider"></view>

              <view class="sheet-setting-row" bindtap="onEditTimeToggle">
                <view class="setting-leading">
                  <view class="setting-icon-wrap">
                    <image class="setting-icon" src="/assets/icons/png/schedule.png" mode="aspectFit" />
                  </view>
                  <text class="setting-title">具体时间</text>
                </view>
                <view class="sheet-switch {{editUseTime ? 'sheet-switch--on' : ''}}">
                  <view class="sheet-switch-thumb"></view>
                </view>
              </view>

              <block wx:if="{{editUseTime}}">
                <view class="sheet-divider sheet-divider--indented"></view>
                <picker mode="time" value="{{editTime}}" bindchange="onEditTimeChange">
                  <view class="sheet-setting-row sheet-setting-row--time">
                    <text class="setting-title">时间</text>
                    <view class="setting-value-wrap">
                      <text class="setting-value setting-value--strong">{{editTime}}</text>
                      <image class="setting-chevron" src="/assets/icons/png/chevron_right.png" mode="aspectFit" />
                    </view>
                  </view>
                </picker>
              </block>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-footer">
        <button class="primary-button save-button" loading="{{editSubmitting}}" bindtap="submitEdit">保存修改</button>
      </view>
    </view>
  </view>
</view>
