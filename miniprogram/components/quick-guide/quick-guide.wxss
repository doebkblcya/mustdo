.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  animation: guide-mask-in 160ms ease-out both;
}

.guide-sheet {
  width: 100%;
  padding: 40rpx 40rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 40rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 72rpx 72rpx 0 0;
  background: #f9f9f9;
  box-sizing: border-box;
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.12);
  animation: guide-sheet-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.guide-head,
.guide-row {
  display: flex;
  align-items: center;
}

.guide-head {
  justify-content: space-between;
  gap: 24rpx;
}

.guide-title {
  color: #000000;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 52rpx;
  letter-spacing: -0.02em;
}

.guide-close {
  display: flex;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eeeeee;
}

.guide-close::after,
.guide-confirm::after {
  display: none;
}

.guide-close:active,
.guide-confirm:active {
  transform: scale(0.97);
  opacity: 0.78;
}

.guide-close-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.72;
}

.guide-list {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: #ffffff;
}

.guide-row {
  min-height: 124rpx;
  gap: 24rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.guide-row + .guide-row {
  border-top: 1rpx solid #ededed;
}

.guide-icon-shell {
  display: flex;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eeeeee;
}

.guide-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.76;
}

.guide-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.guide-row-title,
.guide-row-description {
  display: block;
}

.guide-row-title {
  color: #1a1c1c;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.guide-row-description {
  margin-top: 4rpx;
  color: #77787c;
  font-size: 24rpx;
  line-height: 36rpx;
}

.guide-confirm {
  display: flex;
  width: 100%;
  height: 104rpx;
  margin: 28rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 56rpx;
  background: #000000;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 104rpx;
}

@keyframes guide-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes guide-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
