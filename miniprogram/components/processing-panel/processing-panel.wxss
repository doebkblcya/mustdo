.processing-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(18, 18, 20, 0.34);
}

.processing-panel {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 34rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
}

.panel-header,
.review-heading-row,
.item-main-row,
.item-meta-row,
.error-actions {
  display: flex;
  align-items: center;
}

.panel-header {
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.panel-eyebrow,
.panel-title {
  display: block;
}

.panel-eyebrow {
  margin-bottom: 5rpx;
  color: #8e8e93;
  font-size: 22rpx;
}

.panel-title {
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 650;
}

.panel-close {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #f2f2f7;
  color: #636366;
  font-size: 38rpx;
  line-height: 54rpx;
}

.panel-close::after,
.text-action::after,
.item-delete::after,
.clear-time::after,
.primary-action::after,
.secondary-action::after {
  border: 0;
}

.step-list {
  padding: 4rpx 0 12rpx;
}

.step-row {
  display: flex;
  min-height: 58rpx;
  color: #aeaeb2;
}

.step-marker {
  display: flex;
  flex: 0 0 34rpx;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin: 2rpx 18rpx 0 0;
  border: 2rpx solid #d1d1d6;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
}

.step-row--complete,
.step-row--active {
  color: #1d1d1f;
}

.step-row--complete .step-marker {
  border-color: #1d1d1f;
  background: #1d1d1f;
  color: #fff;
}

.step-row--active .step-marker {
  border-color: #1d1d1f;
}

.step-row--error .step-marker {
  border-color: #d14343;
  background: #d14343;
  color: #fff;
}

.step-spinner {
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #d1d1d6;
  border-top-color: #1d1d1f;
  border-radius: 50%;
  animation: panel-spin 0.8s linear infinite;
}

@keyframes panel-spin {
  to { transform: rotate(360deg); }
}

.step-copy {
  min-width: 0;
  flex: 1;
  padding-bottom: 22rpx;
}

.step-label,
.step-summary {
  display: block;
}

.step-label {
  font-size: 27rpx;
  line-height: 38rpx;
}

.step-summary {
  overflow: hidden;
  margin-top: 2rpx;
  color: #8e8e93;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-section,
.result-section,
.error-section,
.live-detail {
  padding-top: 12rpx;
  border-top: 1rpx solid #ececf0;
}

.review-block {
  padding-top: 22rpx;
}

.review-heading-row {
  justify-content: space-between;
}

.review-heading {
  color: #1d1d1f;
  font-size: 25rpx;
  font-weight: 600;
}

.review-count,
.review-empty-hint,
.live-label,
.preserved-label {
  color: #8e8e93;
  font-size: 23rpx;
}

.text-action,
.item-delete,
.clear-time {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #5c6f91;
  font-size: 23rpx;
  line-height: 40rpx;
}

.transcript-editor {
  width: 100%;
  min-height: 74rpx;
  max-height: 150rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f7f9;
  color: #1d1d1f;
  font-size: 27rpx;
  line-height: 38rpx;
}

.review-items-heading {
  margin-top: 26rpx;
  margin-bottom: 12rpx;
}

.review-list--scroll,
.created-list--scroll {
  max-height: 480rpx;
}

.review-item,
.created-item {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f7f7f9;
}

.item-main-row {
  gap: 14rpx;
}

.item-content-input {
  min-width: 0;
  flex: 1;
  color: #1d1d1f;
  font-size: 27rpx;
}

.item-delete {
  color: #d14343;
}

.item-meta-row {
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-pill {
  padding: 9rpx 15rpx;
  border-radius: 12rpx;
  background: #e9e9ee;
  color: #4b4b50;
  font-size: 22rpx;
}

.review-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 38rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f7f9;
  color: #3a3a3c;
  font-size: 26rpx;
}

.primary-action,
.secondary-action {
  width: 100%;
  margin: 24rpx 0 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.primary-action {
  background: #1d1d1f;
  color: #fff;
}

.primary-action[disabled] {
  background: #d1d1d6;
  color: #fff;
}

.secondary-action {
  background: #f2f2f7;
  color: #1d1d1f;
}

.result-section,
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 26rpx;
}

.result-symbol,
.error-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.result-symbol { background: #2f7d4d; }
.error-symbol { background: #d14343; }

.result-title,
.error-message {
  margin-top: 18rpx;
  color: #1d1d1f;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.created-list {
  width: 100%;
  margin-top: 22rpx;
}

.created-content,
.created-meta,
.live-transcript,
.preserved-text,
.saving-item {
  display: block;
}

.created-content {
  color: #1d1d1f;
  font-size: 27rpx;
}

.created-meta {
  margin-top: 6rpx;
  color: #8e8e93;
  font-size: 22rpx;
}

.preserved-copy,
.live-detail {
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f7f9;
}

.preserved-text,
.live-transcript {
  margin-top: 8rpx;
  color: #3a3a3c;
  font-size: 25rpx;
  line-height: 36rpx;
}

.preserved-items {
  margin-top: 12rpx;
}

.preserved-item {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #3a3a3c;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.error-actions {
  width: 100%;
  gap: 16rpx;
}

.error-actions button {
  flex: 1;
}

.saving-preview {
  margin-top: 12rpx;
}

.saving-item {
  overflow: hidden;
  padding: 5rpx 0;
  color: #3a3a3c;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
