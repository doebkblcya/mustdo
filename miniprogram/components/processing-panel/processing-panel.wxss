.processing-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.processing-panel {
  width: 100%;
  max-height: 82vh;
  padding: 48rpx;
  border-radius: 64rpx;
  background: #f9f9f9;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  color: #1a1c1c;
}

.panel-header,
.review-heading-row,
.item-main-row,
.item-meta-row,
.error-actions {
  display: flex;
  align-items: center;
}

.panel-header {
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.panel-title {
  color: #000000;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 50rpx;
}

.panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #eeeeee;
  color: #5d5e63;
  font-size: 36rpx;
  line-height: 56rpx;
}

.panel-close::after,
.text-action::after,
.item-delete::after,
.clear-time::after,
.primary-action::after,
.secondary-action::after {
  display: none;
}

.step-list {
  padding: 8rpx 8rpx 0;
}

/* 最后一行不再被 min-height 撑高、文字下方不留内边距 —— 让卡片上下留白对称 */
.step-row:last-child {
  min-height: 0;
}

.step-row:last-child .step-copy {
  padding-bottom: 0;
}

.step-row {
  display: flex;
  align-items: stretch;
  gap: 28rpx;
  min-height: 108rpx;
  color: #7e7576;
}

.step-rail {
  display: flex;
  align-items: center;
  flex-direction: column;
  flex: 0 0 52rpx;
}

.step-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #cfc4c5;
  border-radius: 50%;
  background: #f9f9f9;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.step-line {
  flex: 1;
  width: 2rpx;
  min-height: 36rpx;
  margin: 8rpx 0;
  background: #cfc4c5;
}

.step-row--complete,
.step-row--active {
  color: #000000;
}

.step-row--complete .step-marker {
  border-color: #000000;
  background: #000000;
}

.step-row--complete .step-line {
  background: rgba(0, 0, 0, 0.2);
}

.step-row--active .step-marker {
  border-color: transparent;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.step-row--error .step-marker {
  border-color: #ba1a1a;
  background: #ba1a1a;
}

.step-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #000000;
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
  animation: panel-spin 0.8s linear infinite;
}

@keyframes panel-spin {
  to { transform: rotate(360deg); }
}

.step-copy {
  min-width: 0;
  flex: 1;
  padding: 4rpx 0 28rpx;
}

.step-label,
.step-summary {
  display: block;
}

.step-label {
  color: currentColor;
  font-size: 30rpx;
  line-height: 40rpx;
}

.step-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #5d5e63;
  font-size: 26rpx;
  line-height: 36rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* AI 解析完成后：解析出的待办条目（只读），收尾停留期间持续可见 */
.step-parsed {
  margin-top: 12rpx;
}

.step-parsed-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.step-parsed-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1a1c1c;
  font-size: 27rpx;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-parsed-meta {
  flex-shrink: 0;
  color: #5d5e63;
  font-size: 22rpx;
  line-height: 32rpx;
}

.review-block {
  padding-top: 4rpx;
}

.review-heading-row {
  justify-content: space-between;
}

.review-heading,
.review-empty-hint,
.preserved-label {
  color: #5d5e63;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  letter-spacing: 0.04em;
}

.text-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #5d5e63;
  font-size: 24rpx;
  line-height: 36rpx;
}

.refresh-icon {
  font-size: 32rpx;
}

.transcript-editor {
  width: 100%;
  min-height: 92rpx;
  max-height: 180rpx;
  margin-top: 20rpx;
  padding: 24rpx 36rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 48rpx;
  background: #ffffff;
  color: #000000;
  font-size: 26rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

.review-items-heading {
  margin-top: 36rpx;
  margin-bottom: 20rpx;
}

.review-list--scroll {
  max-height: 480rpx;
}

.review-item {
  margin-bottom: 20rpx;
  padding: 24rpx 36rpx;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.item-main-row {
  gap: 16rpx;
}

.item-content-input {
  min-width: 0;
  flex: 1;
  color: #000000;
  font-size: 30rpx;
  line-height: 40rpx;
}

.item-delete,
.clear-time {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #7e7576;
  font-size: 23rpx;
  line-height: 36rpx;
}

.item-delete {
  color: #ba1a1a;
}

.item-meta-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-pill {
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: #eeeeee;
  color: #5d5e63;
  font-size: 22rpx;
  line-height: 30rpx;
}

.review-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 24rpx;
  border-radius: 48rpx;
  background: #ffffff;
  color: #5d5e63;
  font-size: 26rpx;
}

.primary-action,
.secondary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 32rpx 0 0;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.primary-action {
  background: #000000;
  color: #ffffff;
}

.primary-action[disabled] {
  background: #dadada;
}

.secondary-action {
  background: #eeeeee;
  color: #000000;
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-message {
  margin-top: 20rpx;
  color: #000000;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
}

.preserved-text,
.preserved-item {
  display: block;
}

.preserved-copy {
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.preserved-text,
.preserved-item {
  margin-top: 8rpx;
  color: #5d5e63;
  font-size: 25rpx;
  line-height: 36rpx;
}

.error-actions {
  width: 100%;
  gap: 16rpx;
}

.error-actions button {
  flex: 1;
}

/* Local Material Symbols assets. */
.panel-close-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.step-state-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.step-state-icon--error {
  width: 48rpx;
  height: 48rpx;
}

.step-row--error .step-marker {
  border-color: transparent;
  background: transparent;
}

.step-spinner {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border: 0;
  border-radius: 0;
  animation: panel-spin 0.8s linear infinite;
}

.refresh-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
  opacity: 0.68;
}

.error-symbol {
  display: block;
  width: 80rpx;
  height: 80rpx;
  background: transparent;
}
