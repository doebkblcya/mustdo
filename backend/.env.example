# 应用密钥，用于签名 session token 和邀请码 hash（生产环境请使用随机长字符串）
SECRET_KEY=change-me-in-production

# SQLite 数据库文件路径（相对路径基于 backend/ 目录）
DATABASE_PATH=./mustdo.db

# 时区
TIMEZONE=Asia/Shanghai

# 登录态有效期（天）
SESSION_DAYS=30

# 语音录音时长限制（秒）
MAX_AUDIO_SECONDS=60
MIN_AUDIO_SECONDS=0.5

# 火山引擎语音识别 —— 新版控制台只需 VOLC_API_KEY
VOLC_API_KEY=
# 旧版控制台使用以下两个（与 VOLC_API_KEY 二选一）
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# DeepSeek AI 解析
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
