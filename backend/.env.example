# 应用密钥，用于签名 session token 和邀请码 hash（生产环境请使用随机长字符串）
SECRET_KEY=change-me-in-production

# SQLite 数据库文件路径（相对路径基于 backend/ 目录）
DATABASE_PATH=./mustdo.db

# 时区
TIMEZONE=Asia/Shanghai

# 登录态有效期（天）
SESSION_DAYS=30

# 语音录音时长限制（秒）
MAX_AUDIO_SECONDS=60
MIN_AUDIO_SECONDS=0.5

# 火山引擎语音识别 —— 新版控制台只需 VOLC_API_KEY
VOLC_API_KEY=
# 旧版控制台使用以下两个（与 VOLC_API_KEY 二选一）
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# DeepSeek AI 解析
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 微信小程序静默登录 —— 需与小程序 project.config.json 的 appid 配对（测试号或正式号）
# appid 与小程序一致，secret 取自对应小程序后台；两者都须填写，否则 /api/auth/wechat 返回 wechat_config_missing
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信订阅消息模板 ID（小程序后台 → 订阅消息 → 我的模板，选中「待办事项提醒」模板后复制）
# 不填时提醒调度不会发送（pending 保持等待，配置后重启即补发）
WECHAT_TEMPLATE_ID=

# ── 管理后台（/admin/）可选配置，均有合理默认值，生产通常不用改 ──
# 登录态有效期（秒），默认 1800（30 分钟）
ADMIN_SESSION_SECONDS=1800
# 登录 Cookie 是否要求 HTTPS（1=是）。生产走 HTTPS 请保持 1；本机/HTTP 调试用 0
ADMIN_COOKIE_SECURE=1
